+# SPDX-License-Identifier: Apache-2.0
+"""Triton helpers for HEAL INT16 KV-cache experiments."""
+
+import torch
+
+from vllm.platforms import current_platform
+from vllm.triton_utils import tl, triton
+
+
+if current_platform.is_rocm():
+
+    @triton.jit
+    def _round_int16(x):
+        return tl.extra.hip.libdevice.round(x).to(tl.int16)
+
+else:
+
+    @triton.jit
+    def _round_int16(x):
+        return tl.extra.cuda.libdevice.round(x).to(tl.int16)
+
+
+@triton.jit
+def _quantize_int16_vector_kernel(
+    src_ptr,
+    dst_i16_ptr,
+    scale_ptr,
+    src_stride_0: tl.int64,
+    src_stride_1: tl.int64,
+    src_stride_2: tl.int64,
+    dst_stride_0: tl.int64,
+    dst_stride_1: tl.int64,
+    dst_stride_2: tl.int64,
+    scale_stride_0: tl.int64,
+    scale_stride_1: tl.int64,
+    head_size: tl.constexpr,
+    HEAD_SIZE_PADDED: tl.constexpr,
+):
+    token_idx = tl.program_id(axis=0)
+    head_idx = tl.program_id(axis=1)
+    offs_d = tl.arange(0, HEAD_SIZE_PADDED)
+    dim_mask = offs_d < head_size
+
+    src_offset = (
+        token_idx * src_stride_0 + head_idx * src_stride_1 + offs_d * src_stride_2
+    )
+    dst_offset = (
+        token_idx * dst_stride_0 + head_idx * dst_stride_1 + offs_d * dst_stride_2
+    )
+    scale_offset = token_idx * scale_stride_0 + head_idx * scale_stride_1
+
+    x = tl.load(src_ptr + src_offset, mask=dim_mask, other=0.0).to(tl.float32)
+    absmax = tl.max(tl.abs(tl.where(dim_mask, x, 0.0)), axis=0)
+    valid = (absmax > 0.0) & (absmax < float("inf")) & (absmax == absmax)
+    scale = tl.where(valid, absmax / 32767.0, 1.0)
+    q = tl.where(valid, x / scale, 0.0)
+    q = tl.minimum(tl.maximum(q, -32767.0), 32767.0)
+    q = _round_int16(q)
+
+    tl.store(dst_i16_ptr + dst_offset, q, mask=dim_mask)
+    tl.store(scale_ptr + scale_offset, scale)
+
+
+def triton_quantize_int16_q(query: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    assert query.ndim == 3, "HEAL.3 expects query as [tokens, heads, head_size]"
+    query_i16 = torch.empty(query.shape, dtype=torch.int16, device=query.device)
+    q_scale = torch.empty(query.shape[:-1], dtype=torch.float32, device=query.device)
+    head_size = query.shape[2]
+    head_size_padded = triton.next_power_of_2(head_size)
+    grid = (query.shape[0], query.shape[1])
+
+    _quantize_int16_vector_kernel[grid](
+        src_ptr=query,
+        dst_i16_ptr=query_i16,
+        scale_ptr=q_scale,
+        src_stride_0=query.stride(0),
+        src_stride_1=query.stride(1),
+        src_stride_2=query.stride(2),
+        dst_stride_0=query_i16.stride(0),
+        dst_stride_1=query_i16.stride(1),
+        dst_stride_2=query_i16.stride(2),
+        scale_stride_0=q_scale.stride(0),
+        scale_stride_1=q_scale.stride(1),
+        head_size=head_size,
+        HEAD_SIZE_PADDED=head_size_padded,
+        num_warps=1,
+    )
+    return query_i16, q_scale
+
+
+@triton.jit
+def _reshape_and_cache_int16_v_kernel(
+    key_ptr,
+    value_ptr,
+    key_cache_ptr,
+    value_cache_i16_ptr,
+    v_scale_cache_ptr,
+    slot_mapping_ptr,
+    key_stride_0: tl.int64,
+    key_stride_1: tl.int64,
+    key_stride_2: tl.int64,
+    value_stride_0: tl.int64,
+    value_stride_1: tl.int64,
+    value_stride_2: tl.int64,
+    cache_stride_0: tl.int64,
+    cache_stride_1: tl.int64,
+    cache_stride_2: tl.int64,
+    cache_stride_3: tl.int64,
+    scale_stride_0: tl.int64,
+    scale_stride_1: tl.int64,
+    scale_stride_2: tl.int64,
+    block_size: tl.constexpr,
+    head_size: tl.constexpr,
+    HEAD_SIZE_PADDED: tl.constexpr,
+):
+    token_idx = tl.program_id(axis=0)
+    head_idx = tl.program_id(axis=1)
+    slot_idx = tl.load(slot_mapping_ptr + token_idx).to(tl.int64)
+    if slot_idx < 0:
+        return
+
+    block_idx = slot_idx // block_size
+    block_offset = slot_idx % block_size
+    offs_d = tl.arange(0, HEAD_SIZE_PADDED)
+    dim_mask = offs_d < head_size
+
+    key_offset = (
+        token_idx * key_stride_0 + head_idx * key_stride_1 + offs_d * key_stride_2
+    )
+    value_offset = (
+        token_idx * value_stride_0
+        + head_idx * value_stride_1
+        + offs_d * value_stride_2
+    )
+    cache_offset = (
+        block_idx * cache_stride_0
+        + block_offset * cache_stride_1
+        + head_idx * cache_stride_2
+        + offs_d * cache_stride_3
+    )
+    scale_offset = (
+        block_idx * scale_stride_0
+        + block_offset * scale_stride_1
+        + head_idx * scale_stride_2
+    )
+
+    key = tl.load(key_ptr + key_offset, mask=dim_mask, other=0.0)
+    value = tl.load(value_ptr + value_offset, mask=dim_mask, other=0.0).to(tl.float32)
+
+    absmax = tl.max(tl.abs(tl.where(dim_mask, value, 0.0)), axis=0)
+    valid = (absmax > 0.0) & (absmax < float("inf")) & (absmax == absmax)
+    scale = tl.where(valid, absmax / 32767.0, 1.0)
+    q_value = tl.where(valid, value / scale, 0.0)
+    q_value = tl.minimum(tl.maximum(q_value, -32767.0), 32767.0)
+    q_value = _round_int16(q_value)
+
+    tl.store(key_cache_ptr + cache_offset, key, mask=dim_mask)
+    tl.store(value_cache_i16_ptr + cache_offset, q_value, mask=dim_mask)
+    tl.store(v_scale_cache_ptr + scale_offset, scale)
+
+
+def triton_reshape_and_cache_flash_int16_v(
+    key: torch.Tensor,
+    value: torch.Tensor,
