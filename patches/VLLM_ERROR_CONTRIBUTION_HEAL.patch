+
+if HAS_TRITON:
+
+    @triton.autotune(
+        configs=[
+            triton.Config(
+                {"BLOCK_SIZE_M": 128, "BLOCK_SIZE_N": 256, "BLOCK_SIZE_K": 64},
+                num_stages=3,
+                num_warps=8,
+            ),
+            triton.Config(
+                {"BLOCK_SIZE_M": 64, "BLOCK_SIZE_N": 256, "BLOCK_SIZE_K": 32},
+                num_stages=4,
+                num_warps=4,
+            ),
+            triton.Config(
+                {"BLOCK_SIZE_M": 128, "BLOCK_SIZE_N": 128, "BLOCK_SIZE_K": 32},
+                num_stages=4,
+                num_warps=4,
+            ),
+            triton.Config(
+                {"BLOCK_SIZE_M": 128, "BLOCK_SIZE_N": 64, "BLOCK_SIZE_K": 32},
+                num_stages=4,
+                num_warps=4,
+            ),
+            triton.Config(
+                {"BLOCK_SIZE_M": 64, "BLOCK_SIZE_N": 128, "BLOCK_SIZE_K": 32},
+                num_stages=4,
+                num_warps=4,
+            ),
+            triton.Config(
+                {"BLOCK_SIZE_M": 64, "BLOCK_SIZE_N": 64, "BLOCK_SIZE_K": 32},
+                num_stages=4,
+                num_warps=2,
+            ),
+        ],
+        key=["M", "N", "K"],
+    )
+    @triton.jit
+    def _triton_fp32_gemm_kernel(
+        a_ptr,
+        b_ptr,
+        c_ptr,
+        bias_ptr,
+        M,
+        N,
+        K,
+        stride_am,
+        stride_ak,
+        stride_bk,
+        stride_bn,
+        stride_cm,
+        stride_cn,
+        HAS_BIAS: tl.constexpr,
+        BLOCK_SIZE_M: tl.constexpr,
+        BLOCK_SIZE_N: tl.constexpr,
+        BLOCK_SIZE_K: tl.constexpr,
+    ):
+        pid_m = tl.program_id(axis=0)
+        pid_n = tl.program_id(axis=1)
+
+        offs_m = pid_m * BLOCK_SIZE_M + tl.arange(0, BLOCK_SIZE_M)
+        offs_n = pid_n * BLOCK_SIZE_N + tl.arange(0, BLOCK_SIZE_N)
+        offs_k = tl.arange(0, BLOCK_SIZE_K)
+
+        a_ptrs = a_ptr + offs_m[:, None] * stride_am + offs_k[None, :] * stride_ak
+        b_ptrs = b_ptr + offs_k[:, None] * stride_bk + offs_n[None, :] * stride_bn
+
+        acc = tl.zeros((BLOCK_SIZE_M, BLOCK_SIZE_N), dtype=tl.float32)
+        for k_start in range(0, tl.cdiv(K, BLOCK_SIZE_K)):
+            remaining_k = K - k_start * BLOCK_SIZE_K
+            a = tl.load(
+                a_ptrs,
+                mask=(offs_m[:, None] < M) & (offs_k[None, :] < remaining_k),
+                other=0.0,
+            )
+            b = tl.load(
+                b_ptrs,
+                mask=(offs_k[:, None] < remaining_k) & (offs_n[None, :] < N),
+                other=0.0,
+            )
+            acc = tl.dot(a, b, acc=acc)
+            a_ptrs += BLOCK_SIZE_K * stride_ak
+            b_ptrs += BLOCK_SIZE_K * stride_bk
+
+        if HAS_BIAS:
+            bias = tl.load(bias_ptr + offs_n, mask=offs_n < N, other=0.0).to(
+                tl.float32
+            )
+            acc += bias[None, :]
+
+        c_ptrs = c_ptr + offs_m[:, None] * stride_cm + offs_n[None, :] * stride_cn
+        tl.store(c_ptrs, acc, mask=(offs_m[:, None] < M) & (offs_n[None, :] < N))
+
+else:
+    _triton_fp32_gemm_kernel = None
+
+
+def _triton_fp32_gemm(
+    x: torch.Tensor,
+    weight_t: torch.Tensor,
+    bias: torch.Tensor | None = None,
+) -> torch.Tensor:
+    if not HAS_TRITON or _triton_fp32_gemm_kernel is None:
+        raise RuntimeError("Triton is required for FP32-output GEMM.")
+
+    if x.ndim != 2 or weight_t.ndim != 2:
+        raise ValueError("FP32-output GEMM expects 2D activation and weight tensors.")
+    if x.dtype != torch.float16 or weight_t.dtype != torch.float16:
+        raise TypeError(
+            "FP32-output GEMM expects float16 activation and weight inputs, "
+            f"got x={x.dtype}, weight_t={weight_t.dtype}."
+        )
+    if x.shape[1] != weight_t.shape[0]:
+        raise ValueError(
+            "Incompatible GEMM shapes: "
+            f"x={tuple(x.shape)}, weight_t={tuple(weight_t.shape)}."
+        )
+    if bias is not None and bias.numel() != weight_t.shape[1]:
+        raise ValueError(
+            "Bias shape does not match the output dimension: "
+            f"bias={tuple(bias.shape)}, N={weight_t.shape[1]}."
+        )
+
+    m, k = x.shape
+    _, n = weight_t.shape
+    out = torch.empty((m, n), device=x.device, dtype=torch.float32)
+    if m == 0 or n == 0:
+        return out
+
+    bias_arg = out if bias is None else bias
+    grid = lambda meta: (
+        triton.cdiv(m, meta["BLOCK_SIZE_M"]),
+        triton.cdiv(n, meta["BLOCK_SIZE_N"]),
+    )
+    _triton_fp32_gemm_kernel[grid](
+        a_ptr=x,
+        b_ptr=weight_t,
+        c_ptr=out,
+        bias_ptr=bias_arg,
+        M=m,
+        N=n,
+        K=k,
+        stride_am=x.stride(0),
+        stride_ak=x.stride(1),
+        stride_bk=weight_t.stride(0),
+        stride_bn=weight_t.stride(1),
+        stride_cm=out.stride(0),
+        stride_cn=out.stride(1),
+        HAS_BIAS=bias is not None,
+    )
+    return out
+
+
+def blaslt_fp32_gemm(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    bias: torch.Tensor | None = None,
+    output_scale: float | None = None,
+) -> torch.Tensor:
+    if x.ndim != 2 or weight.ndim != 2:
+        raise ValueError("FP32-output GEMM expects 2D activation and weight tensors.")
+    if x.shape[1] != weight.shape[1]:
+        raise ValueError(
+            "Incompatible GEMM shapes: "
+            f"x={tuple(x.shape)}, weight={tuple(weight.shape)}."
+        )
+
+    if current_platform.is_cuda_alike() and hasattr(
+        torch.ops._C, "blaslt_fp32_output_gemm"
+    ):
+        if x.dtype != weight.dtype:
+            x = x.to(weight.dtype)
+        x = x.contiguous()
+        weight = weight.contiguous()
+        out = torch.empty(
+            (x.shape[0], weight.shape[0]),
+            device=x.device,
+            dtype=torch.float32,
+        )
+        ops.blaslt_fp32_output_gemm(out, x, weight, None)
+    elif current_platform.is_cuda_alike() and weight.dtype == torch.float16:
+        if not _allow_triton_fp32_gemm():
+            raise RuntimeError(
+                "HEAL FP32-output GEMM requires the native "
+                "torch.ops._C.blaslt_fp32_output_gemm op. The Triton fallback "
+                "is available only when HEAL_ALLOW_TRITON_FP32_GEMM=1 is set "
+                "explicitly."
+            )
+        if x.dtype != torch.float16:
+            x = x.to(torch.float16)
+        out = _triton_fp32_gemm(x.contiguous(), weight.t().contiguous(), None)
+    else:
+        out = F.linear(x.to(torch.float32), weight.to(torch.float32), None)
+
+    if output_scale is not None and output_scale != 1.0:
+        out.mul_(1.0 / output_scale)
+    if bias is not None:
+        out.add_(bias.to(torch.float32))
+    return out
+
+
+def _int8_split_scaled_mm_fp32(
+    q_activation: torch.Tensor,
+    q_weight_t: torch.Tensor,
+    act_scale: torch.Tensor,
+    weight_scale: torch.Tensor,
+) -> torch.Tensor:
+    if not HAS_TRITON:
+        raise RuntimeError(
+            "HEAL INT8 compensation requires Triton scaled_mm, but Triton is "
+            "not available in this environment."
+        )
+    if not q_activation.is_cuda:
+        raise RuntimeError(
+            "HEAL INT8 compensation requires CUDA tensors because "
+            "triton_scaled_mm only runs on CUDA."
+        )
+    if q_activation.ndim != 2 or q_weight_t.ndim != 2:
+        raise RuntimeError(
+            "HEAL INT8 compensation expects 2D activation and weight tensors, "
+            f"got q_activation={tuple(q_activation.shape)}, "
+            f"q_weight_t={tuple(q_weight_t.shape)}."
+        )
+    m, k = q_activation.shape
+    weight_k, n = q_weight_t.shape
+    if weight_k != k:
+        raise RuntimeError(
+            "HEAL INT8 compensation shape mismatch: "
+            f"q_activation={tuple(q_activation.shape)}, "
+            f"q_weight_t={tuple(q_weight_t.shape)}."
+        )
+    if act_scale.numel() != m:
+        raise RuntimeError(
+            "HEAL INT8 compensation activation scale must be per-row "
+            f"with {m} entries, got shape={tuple(act_scale.shape)}."
+        )
+    if weight_scale.numel() != n:
+        raise RuntimeError(
+            "HEAL INT8 compensation weight scale must be per-output "
+            f"with {n} entries, got shape={tuple(weight_scale.shape)}."
+        )
+    if q_weight_t.stride(0) != 1:
+        q_weight_t = q_weight_t.t().contiguous().t()
+
