--- /dev/null
+++ b/csrc/heal_blaslt_gemm.cu
@@ -0,0 +1,298 @@
+// SPDX-License-Identifier: Apache-2.0
+// FP16/BF16 input GEMM with FP32 accumulation and FP32 output via BLASLt.
+
+#include <ATen/cuda/CUDAContext.h>
+#include <c10/cuda/CUDAGuard.h>
+#ifdef USE_ROCM
+#include <hipblaslt/hipblaslt.h>
+#else
+#include <cublasLt.h>
+#endif
+#include <torch/all.h>
+
+#include <limits>
+#include <mutex>
+#include <tuple>
+#include <unordered_map>
+
+namespace {
+
+#ifdef USE_ROCM
+using BlasltDataType = hipDataType;
+using BlasltEpilogue = hipblasLtEpilogue_t;
+using BlasltHandle = hipblasLtHandle_t;
+using BlasltMatrixLayout = hipblasLtMatrixLayout_t;
+using BlasltMatmulAlgo = hipblasLtMatmulAlgo_t;
+using BlasltMatmulDesc = hipblasLtMatmulDesc_t;
+using BlasltMatmulHeuristicResult = hipblasLtMatmulHeuristicResult_t;
+using BlasltMatmulPreference = hipblasLtMatmulPreference_t;
+using BlasltOperation = hipblasOperation_t;
+constexpr auto kBlasltCompute32F = HIPBLAS_COMPUTE_32F;
+constexpr auto kBlasltData16BF = HIP_R_16BF;
+constexpr auto kBlasltData16F = HIP_R_16F;
+constexpr auto kBlasltData32F = HIP_R_32F;
+constexpr auto kBlasltEpilogueBias = HIPBLASLT_EPILOGUE_BIAS;
+constexpr auto kBlasltOpN = HIPBLAS_OP_N;
+constexpr auto kBlasltOpT = HIPBLAS_OP_T;
+constexpr auto kBlasltPrefMaxWorkspaceBytes =
+    HIPBLASLT_MATMUL_PREF_MAX_WORKSPACE_BYTES;
+constexpr auto kBlasltStatusSuccess = HIPBLAS_STATUS_SUCCESS;
+#define HEAL_BLASLT_CREATE hipblasLtCreate
+#define HEAL_BLASLT_MATRIX_LAYOUT_CREATE hipblasLtMatrixLayoutCreate
+#define HEAL_BLASLT_MATRIX_LAYOUT_DESTROY hipblasLtMatrixLayoutDestroy
+#define HEAL_BLASLT_MATMUL hipblasLtMatmul
+#define HEAL_BLASLT_MATMUL_ALGO_GET_HEURISTIC hipblasLtMatmulAlgoGetHeuristic
+#define HEAL_BLASLT_MATMUL_DESC_CREATE hipblasLtMatmulDescCreate
+#define HEAL_BLASLT_MATMUL_DESC_DESTROY hipblasLtMatmulDescDestroy
+#define HEAL_BLASLT_MATMUL_DESC_SET_ATTRIBUTE hipblasLtMatmulDescSetAttribute
+#define HEAL_BLASLT_MATMUL_PREF_CREATE hipblasLtMatmulPreferenceCreate
+#define HEAL_BLASLT_MATMUL_PREF_DESTROY hipblasLtMatmulPreferenceDestroy
+#define HEAL_BLASLT_MATMUL_PREF_SET_ATTRIBUTE hipblasLtMatmulPreferenceSetAttribute
+#define HEAL_BLASLT_MATMUL_DESC_BIAS_POINTER HIPBLASLT_MATMUL_DESC_BIAS_POINTER
+#define HEAL_BLASLT_MATMUL_DESC_EPILOGUE HIPBLASLT_MATMUL_DESC_EPILOGUE
+#define HEAL_BLASLT_MATMUL_DESC_TRANSA HIPBLASLT_MATMUL_DESC_TRANSA
+#define HEAL_BLASLT_MATMUL_DESC_TRANSB HIPBLASLT_MATMUL_DESC_TRANSB
+#else
+using BlasltDataType = cudaDataType_t;
+using BlasltEpilogue = cublasLtEpilogue_t;
+using BlasltHandle = cublasLtHandle_t;
+using BlasltMatrixLayout = cublasLtMatrixLayout_t;
+using BlasltMatmulAlgo = cublasLtMatmulAlgo_t;
+using BlasltMatmulDesc = cublasLtMatmulDesc_t;
+using BlasltMatmulHeuristicResult = cublasLtMatmulHeuristicResult_t;
+using BlasltMatmulPreference = cublasLtMatmulPreference_t;
+using BlasltOperation = cublasOperation_t;
+constexpr auto kBlasltCompute32F = CUBLAS_COMPUTE_32F;
+constexpr auto kBlasltData16BF = CUDA_R_16BF;
+constexpr auto kBlasltData16F = CUDA_R_16F;
+constexpr auto kBlasltData32F = CUDA_R_32F;
+constexpr auto kBlasltEpilogueBias = CUBLASLT_EPILOGUE_BIAS;
+constexpr auto kBlasltOpN = CUBLAS_OP_N;
+constexpr auto kBlasltOpT = CUBLAS_OP_T;
+constexpr auto kBlasltPrefMaxWorkspaceBytes =
+    CUBLASLT_MATMUL_PREF_MAX_WORKSPACE_BYTES;
+constexpr auto kBlasltStatusSuccess = CUBLAS_STATUS_SUCCESS;
+#define HEAL_BLASLT_CREATE cublasLtCreate
+#define HEAL_BLASLT_MATRIX_LAYOUT_CREATE cublasLtMatrixLayoutCreate
+#define HEAL_BLASLT_MATRIX_LAYOUT_DESTROY cublasLtMatrixLayoutDestroy
+#define HEAL_BLASLT_MATMUL cublasLtMatmul
+#define HEAL_BLASLT_MATMUL_ALGO_GET_HEURISTIC cublasLtMatmulAlgoGetHeuristic
+#define HEAL_BLASLT_MATMUL_DESC_CREATE cublasLtMatmulDescCreate
+#define HEAL_BLASLT_MATMUL_DESC_DESTROY cublasLtMatmulDescDestroy
+#define HEAL_BLASLT_MATMUL_DESC_SET_ATTRIBUTE cublasLtMatmulDescSetAttribute
+#define HEAL_BLASLT_MATMUL_PREF_CREATE cublasLtMatmulPreferenceCreate
+#define HEAL_BLASLT_MATMUL_PREF_DESTROY cublasLtMatmulPreferenceDestroy
+#define HEAL_BLASLT_MATMUL_PREF_SET_ATTRIBUTE cublasLtMatmulPreferenceSetAttribute
+#define HEAL_BLASLT_MATMUL_DESC_BIAS_POINTER CUBLASLT_MATMUL_DESC_BIAS_POINTER
+#define HEAL_BLASLT_MATMUL_DESC_EPILOGUE CUBLASLT_MATMUL_DESC_EPILOGUE
+#define HEAL_BLASLT_MATMUL_DESC_TRANSA CUBLASLT_MATMUL_DESC_TRANSA
+#define HEAL_BLASLT_MATMUL_DESC_TRANSB CUBLASLT_MATMUL_DESC_TRANSB
+#endif
+
+constexpr size_t kMaxWorkspaceBytes = 0;
+
+struct AlgoKey {
+  int device;
+  int64_t m;
+  int64_t n;
+  int64_t k;
+  int dtype;
+  bool has_bias;
+
+  bool operator==(const AlgoKey& other) const {
+    return device == other.device && m == other.m && n == other.n &&
+           k == other.k && dtype == other.dtype && has_bias == other.has_bias;
+  }
+};
+
+struct AlgoKeyHash {
+  size_t operator()(const AlgoKey& key) const {
+    size_t h = std::hash<int>{}(key.device);
+    auto mix = [&h](auto value) {
+      using Value = std::decay_t<decltype(value)>;
+      h ^= std::hash<Value>{}(value) + 0x9e3779b97f4a7c15ULL +
+           (h << 6) + (h >> 2);
+    };
+    mix(key.m);
+    mix(key.n);
+    mix(key.k);
+    mix(key.dtype);
+    mix(key.has_bias);
+    return h;
+  }
+};
+
+std::mutex g_algo_cache_mutex;
+std::unordered_map<AlgoKey, BlasltMatmulAlgo, AlgoKeyHash> g_algo_cache;
+
+BlasltHandle get_blaslt_handle() {
+  static BlasltHandle handle = [] {
+    BlasltHandle h;
+    TORCH_CUDABLAS_CHECK(HEAL_BLASLT_CREATE(&h));
+    return h;
+  }();
+  return handle;
+}
+
+BlasltDataType blaslt_type_for_tensor(const torch::Tensor& tensor) {
+  if (tensor.dtype() == torch::kFloat16) {
+    return kBlasltData16F;
+  }
+  if (tensor.dtype() == torch::kBFloat16) {
+    return kBlasltData16BF;
+  }
+  TORCH_CHECK(false,
+              "blaslt_fp32_output_gemm: expected float16 or bfloat16 input, "
+              "got ",
+              tensor.dtype());
+}
+
+BlasltMatrixLayout make_column_major_layout(BlasltDataType type,
+                                                int64_t rows, int64_t cols,
+                                                int64_t ld) {
+  BlasltMatrixLayout layout;
+  TORCH_CUDABLAS_CHECK(
+      HEAL_BLASLT_MATRIX_LAYOUT_CREATE(&layout, type, rows, cols, ld));
+  return layout;
+}
+
+BlasltMatmulAlgo get_heuristic_algo(BlasltHandle handle,
+                                        BlasltMatmulDesc matmul_desc,
+                                        BlasltMatrixLayout a_desc,
+                                        BlasltMatrixLayout b_desc,
+                                        BlasltMatrixLayout c_desc,
+                                        BlasltMatrixLayout d_desc,
+                                        const AlgoKey& key) {
+  {
+    std::lock_guard<std::mutex> lock(g_algo_cache_mutex);
+    auto it = g_algo_cache.find(key);
+    if (it != g_algo_cache.end()) {
+      return it->second;
+    }
+  }
+
+  BlasltMatmulPreference preference;
+  TORCH_CUDABLAS_CHECK(HEAL_BLASLT_MATMUL_PREF_CREATE(&preference));
+  TORCH_CUDABLAS_CHECK(HEAL_BLASLT_MATMUL_PREF_SET_ATTRIBUTE(
+      preference, kBlasltPrefMaxWorkspaceBytes,
+      &kMaxWorkspaceBytes, sizeof(kMaxWorkspaceBytes)));
+
+  BlasltMatmulHeuristicResult result;
+  int returned_results = 0;
+  auto status = HEAL_BLASLT_MATMUL_ALGO_GET_HEURISTIC(
+      handle, matmul_desc, a_desc, b_desc, c_desc, d_desc, preference, 1,
+      &result, &returned_results);
+  TORCH_CUDABLAS_CHECK(HEAL_BLASLT_MATMUL_PREF_DESTROY(preference));
+  TORCH_CUDABLAS_CHECK(status);
+  TORCH_CHECK(returned_results > 0 && result.state == kBlasltStatusSuccess,
+              "blaslt_fp32_output_gemm: BLASLt found no supported "
+              "algorithm for this GEMM shape");
+  TORCH_CHECK(result.workspaceSize == 0,
+              "blaslt_fp32_output_gemm: expected zero-workspace algorithm, "
+              "got workspaceSize=",
+              result.workspaceSize);
+
+  {
+    std::lock_guard<std::mutex> lock(g_algo_cache_mutex);
+    g_algo_cache.emplace(key, result.algo);
+  }
+  return result.algo;
+}
+
+}  // namespace
+
+void blaslt_fp32_output_gemm(torch::Tensor& out, torch::Tensor const& a,
+                               torch::Tensor const& b,
+                               std::optional<torch::Tensor> const& bias) {
+  TORCH_CHECK(a.is_cuda() && b.is_cuda() && out.is_cuda(),
+              "blaslt_fp32_output_gemm: all tensors must be CUDA tensors");
+  TORCH_CHECK(a.dim() == 2 && b.dim() == 2 && out.dim() == 2,
+              "blaslt_fp32_output_gemm: expected 2-D tensors");
+  TORCH_CHECK(a.dtype() == b.dtype(),
+              "blaslt_fp32_output_gemm: input and weight dtypes must match");
+  TORCH_CHECK(a.dtype() == torch::kFloat16 || a.dtype() == torch::kBFloat16,
+              "blaslt_fp32_output_gemm: expected float16 or bfloat16 inputs");
+  TORCH_CHECK(out.dtype() == torch::kFloat32,
+              "blaslt_fp32_output_gemm: output must be float32");
+  TORCH_CHECK(a.is_contiguous() && b.is_contiguous() && out.is_contiguous(),
+              "blaslt_fp32_output_gemm: tensors must be contiguous");
+  TORCH_CHECK(a.size(1) == b.size(1),
+              "blaslt_fp32_output_gemm: inner dimensions must match");
+  TORCH_CHECK(out.size(0) == a.size(0) && out.size(1) == b.size(0),
+              "blaslt_fp32_output_gemm: output shape must be [M, N]");
+
+  const auto m = a.size(0);
+  const auto k = a.size(1);
+  const auto n = b.size(0);
+
+  if (m == 0 || n == 0) {
+    return;
+  }
+  TORCH_CHECK(m <= std::numeric_limits<int32_t>::max() &&
+                  n <= std::numeric_limits<int32_t>::max() &&
+                  k <= std::numeric_limits<int32_t>::max(),
+              "blaslt_fp32_output_gemm: dimensions exceed int32 range");
+
+  torch::Tensor bias_tensor;
+  void* bias_ptr = nullptr;
+  const bool has_bias = bias.has_value() && bias->defined();
+  if (has_bias) {
+    bias_tensor = bias.value();
+    TORCH_CHECK(bias_tensor.is_cuda() && bias_tensor.dtype() == torch::kFloat32,
+                "blaslt_fp32_output_gemm: bias must be CUDA float32");
+    TORCH_CHECK(bias_tensor.is_contiguous() && bias_tensor.dim() == 1 &&
+                    bias_tensor.numel() == n,
+                "blaslt_fp32_output_gemm: bias must be contiguous [N]");
+    bias_ptr = bias_tensor.data_ptr();
+  }
+
+  const at::cuda::OptionalCUDAGuard device_guard(device_of(a));
+  auto handle = get_blaslt_handle();
+  auto stream = at::cuda::getCurrentCUDAStream();
+  auto ab_type = blaslt_type_for_tensor(a);
+
+  BlasltMatmulDesc matmul_desc;
+  TORCH_CUDABLAS_CHECK(HEAL_BLASLT_MATMUL_DESC_CREATE(
+      &matmul_desc, kBlasltCompute32F, kBlasltData32F));
+  // Row-major out = a[M, K] @ b[N, K].T is the same memory as the
+  // column-major D[N, M] = b_col[K, N].T @ a_col[K, M].
+  BlasltOperation trans_a = kBlasltOpT;
+  BlasltOperation trans_b = kBlasltOpN;
+  TORCH_CUDABLAS_CHECK(HEAL_BLASLT_MATMUL_DESC_SET_ATTRIBUTE(
+      matmul_desc, HEAL_BLASLT_MATMUL_DESC_TRANSA, &trans_a, sizeof(trans_a)));
+  TORCH_CUDABLAS_CHECK(HEAL_BLASLT_MATMUL_DESC_SET_ATTRIBUTE(
+      matmul_desc, HEAL_BLASLT_MATMUL_DESC_TRANSB, &trans_b, sizeof(trans_b)));
+  if (has_bias) {
+    BlasltEpilogue epilogue = kBlasltEpilogueBias;
+    TORCH_CUDABLAS_CHECK(HEAL_BLASLT_MATMUL_DESC_SET_ATTRIBUTE(
+        matmul_desc, HEAL_BLASLT_MATMUL_DESC_EPILOGUE, &epilogue,
+        sizeof(epilogue)));
+    TORCH_CUDABLAS_CHECK(HEAL_BLASLT_MATMUL_DESC_SET_ATTRIBUTE(
+        matmul_desc, HEAL_BLASLT_MATMUL_DESC_BIAS_POINTER, &bias_ptr,
+        sizeof(bias_ptr)));
+  }
+
+  auto a_desc = make_column_major_layout(ab_type, k, n, k);
+  auto b_desc = make_column_major_layout(ab_type, k, m, k);
+  auto c_desc = make_column_major_layout(kBlasltData32F, n, m, n);
+  auto d_desc = make_column_major_layout(kBlasltData32F, n, m, n);
+
+  const AlgoKey key{a.get_device(), m, n, k, static_cast<int>(a.scalar_type()),
+                    has_bias};
+  auto algo =
+      get_heuristic_algo(handle, matmul_desc, a_desc, b_desc, c_desc, d_desc,
+                         key);
+
+  const float alpha = 1.0f;
+  const float beta = 0.0f;
+  TORCH_CUDABLAS_CHECK(HEAL_BLASLT_MATMUL(
+      handle, matmul_desc, &alpha, b.data_ptr(), a_desc, a.data_ptr(), b_desc,
+      &beta, out.data_ptr(), c_desc, out.data_ptr(), d_desc, &algo, nullptr, 0,
+      stream));
+
+  TORCH_CUDABLAS_CHECK(HEAL_BLASLT_MATRIX_LAYOUT_DESTROY(a_desc));
+  TORCH_CUDABLAS_CHECK(HEAL_BLASLT_MATRIX_LAYOUT_DESTROY(b_desc));
+  TORCH_CUDABLAS_CHECK(HEAL_BLASLT_MATRIX_LAYOUT_DESTROY(c_desc));
+  TORCH_CUDABLAS_CHECK(HEAL_BLASLT_MATRIX_LAYOUT_DESTROY(d_desc));
+  TORCH_CUDABLAS_CHECK(HEAL_BLASLT_MATMUL_DESC_DESTROY(matmul_desc));
+}
