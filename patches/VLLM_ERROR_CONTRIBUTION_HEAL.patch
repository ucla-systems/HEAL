+# SPDX-License-Identifier: Apache-2.0
+"""HEAL precision helpers for local experiments."""
+
+from __future__ import annotations
+
+from contextlib import contextmanager
+import math
+import os
+import re
+
+import torch
+
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+_FP16_MAX = torch.finfo(torch.float16).max
+
+
+@contextmanager
+def _autocast_disabled_for(tensor: torch.Tensor):
+    device_type = tensor.device.type
+    with torch.amp.autocast(device_type="cpu", enabled=False):
+        if device_type in {"cuda", "xpu", "hpu"}:
+            with torch.amp.autocast(device_type=device_type, enabled=False):
+                yield
+        else:
+            yield
+
+
+_HEAL_MODE_ORDER = {
+    "off": 0,
+    "base": 1,
+    "plus": 2,
+    "full": 3,
+}
+_HEAL_MODE_ALIASES = {
+    "": "off",
+    "0": "off",
+    "false": "off",
+    "no": "off",
+    "none": "off",
+    "off": "off",
+    "1": "full",
+    "true": "full",
+    "yes": "full",
+    "on": "full",
+}
+
+
+def _env_enabled(name: str) -> bool:
+    return os.environ.get(name, "").lower() in {"1", "true", "yes", "on"}
+
+
+def heal_mode() -> str:
+    raw_mode = os.environ.get("HEAL_MODE", "off").strip().lower()
+    mode = _HEAL_MODE_ALIASES.get(raw_mode, raw_mode)
+    if mode not in _HEAL_MODE_ORDER:
+        raise ValueError("HEAL_MODE must be one of: off, base, plus, full.")
+    return mode
+
+
+def _mode_at_least(mode: str) -> bool:
+    return _HEAL_MODE_ORDER[heal_mode()] >= _HEAL_MODE_ORDER[mode]
+
+
+def enabled() -> bool:
+    return heal_mode() != "off"
+
+
+def fp32_output_gemm_enabled() -> bool:
+    return enabled()
+
+
+def fp16_weight_scaling_enabled() -> bool:
+    return fp32_output_gemm_enabled()
+
+
+def int16_v_cache_enabled() -> bool:
+    return _mode_at_least("plus")
+
+
+def int16_k_cache_enabled() -> bool:
+    return _mode_at_least("plus")
+
+
+def int16_q_input_enabled() -> bool:
+    return _mode_at_least("plus")
+
+
+def int16_v_cache_split_fp16_dot_enabled() -> bool:
+    return int16_v_cache_enabled()
+
+
+def q_split_fp16_dot_enabled() -> bool:
+    return _mode_at_least("plus")
+
+
+def fp32_attention_output_enabled() -> bool:
+    return heal_mode() == "plus" or (
+        enabled() and _env_enabled("HEAL_FP32_ATTENTION_OUTPUT")
+    )
+
+
+def int8_gemm_split_enabled() -> bool:
+    return fp32_output_gemm_enabled() and _mode_at_least("full")
+
+
+def dynamic_int8_gemm_weight_enabled() -> bool:
+    return _env_enabled("HEAL_DYNAMIC_INT8_GEMM_WEIGHT")
+
+
+def dynamic_int8_gemm_weight_chunk_rows() -> int:
+    raw = os.environ.get("HEAL_DYNAMIC_INT8_GEMM_WEIGHT_CHUNK_ROWS", "1024")
+    try:
+        rows = int(raw)
+    except ValueError:
+        raise ValueError(
+            "HEAL_DYNAMIC_INT8_GEMM_WEIGHT_CHUNK_ROWS must be a positive integer"
+        ) from None
+    if rows <= 0:
+        raise ValueError(
+            "HEAL_DYNAMIC_INT8_GEMM_WEIGHT_CHUNK_ROWS must be a positive integer"
+        )
+    return rows
+
+
+def _parse_layer_list_env(name: str) -> frozenset[int]:
+    raw = os.environ.get(name, "")
+    layers: set[int] = set()
+    for item in re.split(r"[,;\s]+", raw.strip()):
+        if not item:
+            continue
+        if "-" in item:
+            start_raw, end_raw = item.split("-", 1)
+            try:
+                start = int(start_raw)
+                end = int(end_raw)
+            except ValueError:
+                continue
+            lo, hi = sorted((start, end))
+            layers.update(range(lo, hi + 1))
+            continue
+        try:
+            layers.add(int(item))
+        except ValueError:
+            continue
+    return frozenset(layer for layer in layers if layer >= 0)
+
+
+def _int8_gemm_skip_layers() -> frozenset[int]:
+    return _parse_layer_list_env("HEAL_SKIP_INT8_COMP_LAYERS")
+
+
+def _int16_attention_skip_layers() -> frozenset[int]:
+    return _parse_layer_list_env("HEAL_SKIP_QKV_QUANT_LAYERS")
+
+
+def skip_int16_attention_for_index(layer_idx: int | None) -> bool:
+    if heal_mode() != "plus" or layer_idx is None:
+        return False
+    return int(layer_idx) in _int16_attention_skip_layers()
+
+
+def skip_int8_gemm_split_for_layer(layer: torch.nn.Module) -> bool:
+    cached = getattr(layer, "_heal_skip_int8_gemm_split", None)
+    if cached is not None:
+        return bool(cached)
+    layer_idx = _decoder_layer_index(layer)
+    skipped = layer_idx is not None and layer_idx in _int8_gemm_skip_layers()
+    layer._heal_skip_int8_gemm_split = skipped
+    return skipped
+
+
+def use_int8_gemm_split(layer: torch.nn.Module) -> bool:
+    cached = getattr(layer, "_heal_use_int8_gemm_split", None)
+    if cached is not None:
+        return bool(cached)
+    use_split = (
+        int8_gemm_split_enabled()
+        and use_fp32_output_gemm(layer)
+        and not skip_int8_gemm_split_for_layer(layer)
+    )
+    layer._heal_use_int8_gemm_split = use_split
+    return use_split
+
+
+def configure_attention_module(
+    layer: torch.nn.Module,
+    layer_idx: int | None = None,
+) -> None:
+    """Cache HEAL attention switches before compiled forward runs."""
+
+    if layer_idx is None:
+        layer_idx = _decoder_layer_index(layer)
+    mode = heal_mode()
+    skip_int16_attention = skip_int16_attention_for_index(layer_idx)
+    use_int16_q = int16_q_input_enabled() and not skip_int16_attention
+    use_int16_k = int16_k_cache_enabled() and not skip_int16_attention
+    use_int16_v = int16_v_cache_enabled() and not skip_int16_attention
+
+    layer._heal_enabled = enabled()
+    layer._heal_mode = mode
+    layer._heal_skip_int16_attention = skip_int16_attention
+    layer._heal_fp32_attention_output = fp32_attention_output_enabled()
+    layer._heal_int16_q_input = use_int16_q
+    layer._heal_int16_k_cache = use_int16_k
+    layer._heal_int16_v_cache = use_int16_v
+    layer._heal_q_split_fp16_dot = q_split_fp16_dot_enabled()
+    layer._heal_int16_v_cache_split_fp16_dot = (
+        use_int16_v and int16_v_cache_split_fp16_dot_enabled()
+    )
+
+
+def skip_int16_attention_for_layer(layer: torch.nn.Module) -> bool:
+    cached = getattr(layer, "_heal_skip_int16_attention", None)
+    if cached is not None:
+        return bool(cached)
+    layer_idx = _decoder_layer_index(layer)
+    return skip_int16_attention_for_index(layer_idx)
+
+
+def int16_q_input_enabled_for_layer(layer: torch.nn.Module) -> bool:
+    cached = getattr(layer, "_heal_int16_q_input", None)
+    if cached is not None:
+        return bool(cached)
+    return int16_q_input_enabled() and not skip_int16_attention_for_layer(layer)
+
+
+def int16_k_cache_enabled_for_layer(layer: torch.nn.Module) -> bool:
+    cached = getattr(layer, "_heal_int16_k_cache", None)
+    if cached is not None:
+        return bool(cached)
+    return int16_k_cache_enabled() and not skip_int16_attention_for_layer(layer)
+
+
+def int16_v_cache_enabled_for_layer(layer: torch.nn.Module) -> bool:
+    cached = getattr(layer, "_heal_int16_v_cache", None)
+    if cached is not None:
+        return bool(cached)
+    return int16_v_cache_enabled() and not skip_int16_attention_for_layer(layer)
+
+
+def int16_v_cache_split_fp16_dot_enabled_for_layer(
+    layer: torch.nn.Module,
+) -> bool:
+    cached = getattr(layer, "_heal_int16_v_cache_split_fp16_dot", None)
+    if cached is not None:
+        return bool(cached)
+    return int16_v_cache_enabled_for_layer(
+        layer
+    ) and int16_v_cache_split_fp16_dot_enabled()
+
+
+def q_split_fp16_dot_enabled_for_layer(layer: torch.nn.Module) -> bool:
+    cached = getattr(layer, "_heal_q_split_fp16_dot", None)
+    if cached is not None:
+        return bool(cached)
+    return q_split_fp16_dot_enabled()
+
+
+def keep_bf16_norm_weight() -> bool:
+    return enabled()
+
+
+def keep_bf16_gemm_bias(layer: torch.nn.Module) -> bool:
+    return fp32_output_gemm_enabled() and use_fp32_output_gemm(layer)
+
+
+def _decoder_layer_index(layer: torch.nn.Module) -> int | None:
+    prefix = getattr(layer, "prefix", "")
+    parts = str(prefix).split(".")
+    for marker in ("layers", "h"):
+        if marker not in parts:
+            continue
+        index_pos = parts.index(marker) + 1
+        if index_pos < len(parts) and parts[index_pos].isdigit():
+            return int(parts[index_pos])
+    return None
+
+
+def _is_logits_layer(layer: torch.nn.Module) -> bool:
+    return layer.__class__.__name__ == "ParallelLMHead"
+
+
+def decoder_layer_fp32_output_gemm_enabled(layer: torch.nn.Module) -> bool:
+    if not fp32_output_gemm_enabled():
+        return False
+    return _decoder_layer_index(layer) is not None
+
+
+def logits_fp32_output_gemm_enabled(layer: torch.nn.Module) -> bool:
+    return fp32_output_gemm_enabled() and _is_logits_layer(layer)
+
+
+def use_fp32_output_gemm(layer: torch.nn.Module) -> bool:
+    if not fp32_output_gemm_enabled():
+        return False
+    if _is_logits_layer(layer):
+        return logits_fp32_output_gemm_enabled(layer)
+    return decoder_layer_fp32_output_gemm_enabled(layer)
+
+
+def _loaded_weight_scale_exponent(loaded_weight: torch.Tensor) -> int | None:
+    if loaded_weight.numel() == 0:
+        return None
+    max_abs = float(loaded_weight.detach().abs().max().to(torch.float32).item())
+    if not math.isfinite(max_abs):
+        raise ValueError("HEAL weight scaling requires finite loaded weights.")
+    if max_abs <= 0.0:
+        return None
+    return math.floor(math.log2(_FP16_MAX / max_abs))
+
+
+def _scale_loaded_weight(loaded_weight: torch.Tensor, exponent: int) -> torch.Tensor:
+    return loaded_weight.to(torch.float32).mul(math.ldexp(1.0, exponent))
+
+
+def _report_gemm_weight_scale_loss(
+    layer: torch.nn.Module,
+    param: torch.Tensor,
+    loaded_weight: torch.Tensor,
+    prepared: torch.Tensor,
+    scale: float,
+    exponent: int,
+) -> None:
+    ref = loaded_weight.detach().to(torch.float32)
+    prepared_view = prepared.detach().reshape_as(ref)
+    flat_ref = ref.reshape(-1, ref.shape[-1])
+    flat_prepared = prepared_view.reshape_as(flat_ref)
+    rows = flat_ref.shape[0]
+    if rows == 0:
+        return
+
+    sq_sum = 0.0
+    count = 0
+    max_abs = 0.0
+    max_abs_index = 0
+    max_row_mse = -1.0
+    max_row = 0
+    width = flat_ref.shape[-1]
+    chunk_rows = 1024
+    for start in range(0, rows, chunk_rows):
+        end = min(start + chunk_rows, rows)
+        with _autocast_disabled_for(flat_prepared):
+            reconstructed = flat_prepared[start:end].to(param.dtype).to(torch.float32)
+            reconstructed = reconstructed / scale
+            diff = reconstructed - flat_ref[start:end]
+            sq = diff.square()
+            row_sq = sq.sum(dim=-1)
+        row_mse = row_sq / width
+        chunk_max, chunk_idx = row_mse.max(dim=0)
+        chunk_max_value = float(chunk_max.item())
+        if chunk_max_value > max_row_mse:
+            max_row_mse = chunk_max_value
+            max_row = start + int(chunk_idx.item())
+        sq_sum += float(row_sq.sum().item())
+        count += diff.numel()
+        if diff.numel():
+            abs_diff = diff.abs().reshape(-1)
+            chunk_abs, chunk_abs_idx = abs_diff.max(dim=0)
+            chunk_abs_value = float(chunk_abs.item())
+            if chunk_abs_value > max_abs:
+                max_abs = chunk_abs_value
+                max_abs_index = start * width + int(chunk_abs_idx.item())
+
+    layer_name = getattr(layer, "prefix", "") or layer.__class__.__name__
+    logger.info(
+        "HEAL GEMM scaled-FP16 load loss: layer=%s rows=%d cols=%d "
+        "max_row_mse=%.6e max_row=%d global_mse=%.6e "
+        "max_abs=%.6e max_abs_index=%d exponent=%d scale=%.6e",
+        layer_name,
+        rows,
+        width,
+        max_row_mse,
+        max_row,
+        sq_sum / count if count else 0.0,
+        max_abs,
+        max_abs_index,
+        exponent,
+        scale,
+    )
+
+
+def _token_embedding_scale(
+    loaded_weight: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    with _autocast_disabled_for(loaded_weight):
+        loaded_fp32 = loaded_weight.detach().to(torch.float32)
+        flat = loaded_fp32.reshape(-1, loaded_fp32.shape[-1])
+        max_abs = flat.abs().amax(dim=-1).to(torch.float32)
+        if not bool(torch.isfinite(max_abs).all().item()):
+            raise ValueError("HEAL token embedding scaling requires finite weights.")
+
+        exponents = torch.zeros(
+            max_abs.shape, dtype=torch.int32, device=max_abs.device
+        )
+        positive = max_abs > 0
+        if bool(positive.any().item()):
+            fp16_max = torch.tensor(
+                _FP16_MAX, dtype=torch.float32, device=max_abs.device
+            )
+            exponent_values = torch.floor(torch.log2(fp16_max / max_abs[positive]))
+            # Keep the scale itself representable while preserving the practical
+            # "scale up to FP16 range" behavior for normal model weights.
+            exponent_values = exponent_values.clamp(min=-120, max=120)
+            exponents[positive] = exponent_values.to(torch.int32)
+        exponents_cpu = exponents.cpu()
+        scale_cpu = torch.empty(max_abs.shape, dtype=torch.float32)
+        for exponent in torch.unique(exponents_cpu).tolist():
+            exponent_int = int(exponent)
+            scale_cpu[exponents_cpu == exponent_int] = math.ldexp(1.0, exponent_int)
+        scale = scale_cpu.to(device=max_abs.device, dtype=torch.float32)
+        return loaded_fp32, exponents, scale
+
+
+def _report_token_embedding_scale_loss(
+    layer: torch.nn.Module,
+    param: torch.Tensor,
+    loaded_fp32: torch.Tensor,
+    prepared: torch.Tensor,
+    scale: torch.Tensor,
+    exponents: torch.Tensor,
+) -> None:
+    flat_ref = loaded_fp32.reshape(-1, loaded_fp32.shape[-1])
+    flat_prepared = prepared.reshape_as(flat_ref)
+    rows = flat_ref.shape[0]
+    if rows == 0:
+        return
+
+    sq_sum = 0.0
+    count = 0
+    max_abs = 0.0
+    max_token_mse = -1.0
+    max_token_row = 0
+    chunk_rows = 1024
+    for start in range(0, rows, chunk_rows):
+        end = min(start + chunk_rows, rows)
+        with _autocast_disabled_for(flat_prepared):
+            scale_chunk = scale[start:end].reshape(-1, 1).to(torch.float32)
+            reconstructed = flat_prepared[start:end].to(param.dtype).to(torch.float32)
+            reconstructed = reconstructed / scale_chunk
+            diff = reconstructed - flat_ref[start:end]
+            row_sq = diff.square().sum(dim=-1)
+        row_mse = row_sq / diff.shape[-1]
+        chunk_max, chunk_idx = row_mse.max(dim=0)
+        chunk_max_value = float(chunk_max.item())
+        if chunk_max_value > max_token_mse:
+            max_token_mse = chunk_max_value
+            max_token_row = start + int(chunk_idx.item())
+        sq_sum += float(row_sq.sum().item())
+        count += diff.numel()
+        if diff.numel():
+            max_abs = max(max_abs, float(diff.abs().max().item()))
+
+    layer_name = getattr(layer, "prefix", "") or layer.__class__.__name__
+    logger.info(
+        "HEAL token embedding scaled-FP16 load loss: layer=%s rows=%d "
+        "hidden=%d max_token_mse=%.6e max_token_row=%d global_mse=%.6e "
+        "max_abs=%.6e exponent_min=%d exponent_max=%d",
+        layer_name,
+        rows,
+        flat_ref.shape[-1],
+        max_token_mse,
+        max_token_row,
+        sq_sum / count if count else 0.0,
+        max_abs,
+        int(exponents.min().item()),
+        int(exponents.max().item()),
+    )
+
+
+def prepare_token_embedding_weight(
+    layer: torch.nn.Module,
+    param: torch.Tensor,
+    loaded_weight: torch.Tensor,
+    *,
+    target_offset: int = 0,
+) -> torch.Tensor:
+    if (
+        not enabled()
+        or layer.__class__.__name__ != "VocabParallelEmbedding"
+        or not torch.is_floating_point(loaded_weight)
+        or param.dtype != torch.float16
+        or param.dim() < 2
+        or loaded_weight.dim() < 2
+    ):
+        return loaded_weight
+
+    with _autocast_disabled_for(loaded_weight):
+        loaded_fp32, exponents, scale = _token_embedding_scale(loaded_weight)
+        prepared = (
+            loaded_fp32.reshape(-1, loaded_fp32.shape[-1])
+            * scale.reshape(-1, 1)
+        ).reshape_as(loaded_fp32)
+
+    scale_cache = getattr(layer, "_heal_token_embedding_scale", None)
+    expected_shape = (param.shape[0],)
+    if (
+        scale_cache is None
+        or tuple(scale_cache.shape) != expected_shape
+        or scale_cache.device != param.device
+    ):
+        _set_nonpersistent_buffer(
+            layer,
+            "_heal_token_embedding_scale",
+            torch.ones(expected_shape, dtype=torch.float32, device=param.device),
+        )
+        scale_cache = getattr(layer, "_heal_token_embedding_scale")
+    scale_cache.narrow(0, target_offset, scale.numel()).copy_(
+        scale.to(device=param.device, dtype=torch.float32)
+    )
+
+    _report_token_embedding_scale_loss(
+        layer, param, loaded_fp32, prepared, scale, exponents
+    )
+    return prepared
+
+
+def prepare_loaded_weight(
+    layer: torch.nn.Module,
+    param: torch.Tensor,
+    loaded_weight: torch.Tensor,
+) -> torch.Tensor:
+    skip_int8_gemm_split_for_layer(layer)
+    if (
+        not fp16_weight_scaling_enabled()
+        or not use_fp32_output_gemm(layer)
+        or not torch.is_floating_point(loaded_weight)
+        or param.dtype != torch.float16
+        or param.dim() < 2
+        or loaded_weight.dim() < 2
+    ):
+        return loaded_weight
+
+    candidate_exponent = _loaded_weight_scale_exponent(loaded_weight)
+    if candidate_exponent is None:
+        return loaded_weight
+
+    current_exponent = getattr(layer, "_heal_weight_scale_exponent", None)
+    if current_exponent is None:
+        exponent = candidate_exponent
+    else:
+        exponent = min(int(current_exponent), candidate_exponent)
+        if exponent != int(current_exponent):
+            param.data.mul_(math.ldexp(1.0, exponent - int(current_exponent)))
+
+    scale = math.ldexp(1.0, exponent)
+    layer._heal_weight_scale_exponent = exponent
+    layer._heal_weight_output_scale = scale
+    prepared = _scale_loaded_weight(loaded_weight, exponent)
+    _report_gemm_weight_scale_loss(
+        layer, param, loaded_weight, prepared, scale, exponent
+    )
+    return prepared
+
+
+def weight_output_scale(layer: torch.nn.Module) -> float | None:
+    scale = getattr(layer, "_heal_weight_output_scale", None)
+    if scale is None:
+        return None
+    return float(scale)
+
+
+def _set_nonpersistent_buffer(
+    layer: torch.nn.Module,
+    name: str,
+    value: torch.Tensor,
+) -> None:
+    if name in layer._buffers:
+        layer._buffers[name] = value
+    else:
+        layer.register_buffer(name, value, persistent=False)
+
+
+def _clear_int8_gemm_weight(layer: torch.nn.Module) -> None:
+    for name in ("_heal_int8_gemm_weight_t", "_heal_int8_gemm_weight_scale"):
+        if name in getattr(layer, "_buffers", {}):
+            layer._buffers.pop(name, None)
+        elif hasattr(layer, name):
+            delattr(layer, name)
+
+
+@torch.no_grad()
+def prepare_int8_gemm_weight(layer: torch.nn.Module) -> None:
+    if not use_int8_gemm_split(layer):
+        _clear_int8_gemm_weight(layer)
+        return
+    if dynamic_int8_gemm_weight_enabled():
+        _clear_int8_gemm_weight(layer)
+        return
+    weight = getattr(layer, "weight", None)
+    if (
+        weight is None
+        or not torch.is_floating_point(weight)
+        or weight.dim() != 2
+        or weight.numel() == 0
+    ):
+        return
+
+    weight_fp32 = weight.detach().to(torch.float32)
+    scale = weight_fp32.abs().amax(dim=1)
+    scale = scale.clamp_min(torch.finfo(torch.float32).tiny).div(127.0)
+    q_weight = torch.round(weight_fp32 / scale[:, None]).clamp_(-127, 127)
+    q_weight = q_weight.to(torch.int8).contiguous()
+
+    _set_nonpersistent_buffer(
+        layer,
+        "_heal_int8_gemm_weight_t",
+        q_weight.t(),
+    )
+    _set_nonpersistent_buffer(
+        layer,
+        "_heal_int8_gemm_weight_scale",
+        scale.contiguous(),
+    )
+
+
+def fp32_stream_enabled() -> bool:
+    return enabled()
+
+
+def main_stream(
+    x: torch.Tensor | None,
+    active: bool | None = None,
+) -> torch.Tensor | None:
+    if active is None:
+        active = enabled()
+    if x is None or not active or not torch.is_floating_point(x):
+        return x
+    return x if x.dtype == torch.float32 else x.to(torch.float32)
+
+
+def gemm_input(
+    x: torch.Tensor,
+    target_dtype: torch.dtype,
+    active: bool | None = None,
+) -> torch.Tensor:
+    if active is None:
+        active = enabled()
+    if not active or not torch.is_floating_point(x):
+        return x
+    return x if x.dtype == target_dtype else x.to(target_dtype)
+
+
+def attention_inputs(
+    attn_module: torch.nn.Module,
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    heal_enabled = getattr(attn_module, "_heal_enabled", None)
+    if heal_enabled is None:
+        heal_enabled = enabled()
+    if not heal_enabled:
+        return q, k, v
+    target_dtype = getattr(getattr(attn_module, "qkv_proj", None), "weight", q).dtype
+    use_int16_q = int16_q_input_enabled_for_layer(attn_module)
+    use_int16_k = int16_k_cache_enabled_for_layer(attn_module)
+    use_int16_v = int16_v_cache_enabled_for_layer(attn_module)
+    use_q_split = q_split_fp16_dot_enabled_for_layer(attn_module)
+    if use_int16_q or use_int16_k or use_int16_v:
+        q_input = (
+            main_stream(q, heal_enabled)
+            if use_int16_q and use_q_split
+            else gemm_input(q, target_dtype, heal_enabled)
+        )
+        return (
+            q_input,
+            main_stream(k, heal_enabled) if use_int16_k else gemm_input(
+                k, target_dtype, heal_enabled
+            ),
+            main_stream(v, heal_enabled) if use_int16_v else gemm_input(
+                v, target_dtype, heal_enabled
+            ),
+        )
+    return (
+        gemm_input(q, target_dtype, heal_enabled),
+        gemm_input(k, target_dtype, heal_enabled),
+        gemm_input(v, target_dtype, heal_enabled),
+    )
