index 9766103f7..5cdc30d4a 100644
--- a/csrc/layernorm_kernels.cu
+++ b/csrc/layernorm_kernels.cu
@@ -179,6 +179,91 @@ fused_add_rms_norm_kernel(
   }
 }
 
+
+template <typename weight_t, int NUM_DIMS>
+__global__ void heal_rms_norm_fp32_kernel(
+    float* __restrict__ out,          // [..., hidden_size]
+    const float* __restrict__ input,  // [..., hidden_size]
+    const int64_t input_stride_d2,    // input.stride(-2)
+    const int64_t input_stride_d3,    // input.stride(-3)
+    const int64_t input_stride_d4,    // input.stride(-4)
+    const int64_t input_shape_d2,     // input.size(-2)
+    const int64_t input_shape_d3,     // input.size(-3)
+    const weight_t* __restrict__ weight,  // [hidden_size]
+    const float epsilon, const int num_tokens, const int hidden_size) {
+  __shared__ float s_variance;
+  float variance = 0.0f;
+  const float* input_row = nullptr;
+  if constexpr (NUM_DIMS == 2) {
+    input_row = input + blockIdx.x * input_stride_d2;
+  } else if constexpr (NUM_DIMS == 3) {
+    int batch_idx = blockIdx.x / input_shape_d2;
+    int head_idx = blockIdx.x % input_shape_d2;
+    input_row =
+        input + batch_idx * input_stride_d3 + head_idx * input_stride_d2;
+  } else if constexpr (NUM_DIMS == 4) {
+    int batch_idx = blockIdx.x / (input_shape_d3 * input_shape_d2);
+    int remaining = blockIdx.x % (input_shape_d3 * input_shape_d2);
+    int seq_idx = remaining / input_shape_d2;
+    int head_idx = remaining % input_shape_d2;
+    input_row = input + batch_idx * input_stride_d4 +
+                seq_idx * input_stride_d3 + head_idx * input_stride_d2;
+  }
+
+  for (int idx = threadIdx.x; idx < hidden_size; idx += blockDim.x) {
+    float x = input_row[idx];
+    variance += x * x;
+  }
+
+  using BlockReduce = cub::BlockReduce<float, 1024>;
+  __shared__ typename BlockReduce::TempStorage reduceStore;
+  variance = BlockReduce(reduceStore).Reduce(variance, CubAddOp{}, blockDim.x);
+
+  if (threadIdx.x == 0) {
+    s_variance = rsqrtf(variance / hidden_size + epsilon);
+  }
+  __syncthreads();
+
+  float* out_row = out + blockIdx.x * hidden_size;
+  for (int idx = threadIdx.x; idx < hidden_size; idx += blockDim.x) {
+    float weight_fp32 = static_cast<float>(weight[idx]);
+    out_row[idx] = input_row[idx] * s_variance * weight_fp32;
+  }
+}
+
+template <typename weight_t>
+__global__ void heal_fused_add_rms_norm_fp32_kernel(
+    float* __restrict__ input,  // [..., hidden_size]
+    const int64_t input_stride,
+    float* __restrict__ residual,         // [..., hidden_size]
+    const weight_t* __restrict__ weight,  // [hidden_size]
+    const float epsilon, const int num_tokens, const int hidden_size) {
+  __shared__ float s_variance;
+  float variance = 0.0f;
+
+  for (int idx = threadIdx.x; idx < hidden_size; idx += blockDim.x) {
+    float z = input[blockIdx.x * input_stride + idx] +
+              residual[blockIdx.x * hidden_size + idx];
+    variance += z * z;
+    residual[blockIdx.x * hidden_size + idx] = z;
+  }
+
+  using BlockReduce = cub::BlockReduce<float, 1024>;
+  __shared__ typename BlockReduce::TempStorage reduceStore;
+  variance = BlockReduce(reduceStore).Reduce(variance, CubAddOp{}, blockDim.x);
+
+  if (threadIdx.x == 0) {
+    s_variance = rsqrtf(variance / hidden_size + epsilon);
+  }
+  __syncthreads();
+
+  for (int idx = threadIdx.x; idx < hidden_size; idx += blockDim.x) {
+    float x = residual[blockIdx.x * hidden_size + idx];
+    float weight_fp32 = static_cast<float>(weight[idx]);
+    input[blockIdx.x * input_stride + idx] = x * s_variance * weight_fp32;
+  }
+}
+
 }  // namespace vllm
 
 void rms_norm(torch::Tensor& out,     // [..., hidden_size]
@@ -284,3 +369,104 @@ void fused_add_rms_norm(torch::Tensor& input,     // [..., hidden_size]
     LAUNCH_FUSED_ADD_RMS_NORM(0);
   }
 }
+
+void heal_rms_norm_fp32(torch::Tensor& out,     // [..., hidden_size]
+                        torch::Tensor& input,   // [..., hidden_size]
+                        torch::Tensor& weight,  // [hidden_size]
+                        double epsilon) {
+  TORCH_CHECK(out.scalar_type() == at::kFloat,
+              "heal_rms_norm_fp32: output must be float32");
+  TORCH_CHECK(input.scalar_type() == at::kFloat,
+              "heal_rms_norm_fp32: input must be float32");
+  TORCH_CHECK(weight.scalar_type() == at::kFloat ||
+                  weight.scalar_type() == at::kHalf ||
+                  weight.scalar_type() == at::kBFloat16,
+              "heal_rms_norm_fp32: weight must be float32, float16, or "
+              "bfloat16");
+  TORCH_CHECK(out.is_contiguous(),
+              "heal_rms_norm_fp32: output must be contiguous");
+  if (input.stride(-1) != 1) {
+    input = input.contiguous();
+  }
+  TORCH_CHECK(input.stride(-1) == 1,
+              "heal_rms_norm_fp32: input last dimension must be contiguous");
+  TORCH_CHECK(weight.is_contiguous(),
+              "heal_rms_norm_fp32: weight must be contiguous");
+  TORCH_CHECK(out.sizes() == input.sizes(),
+              "heal_rms_norm_fp32: output shape must match input shape");
+
+  int hidden_size = input.size(-1);
+  TORCH_CHECK(weight.numel() == hidden_size,
+              "heal_rms_norm_fp32: weight size must match hidden size");
+
+  int num_tokens = input.numel() / hidden_size;
+  int num_dims = input.dim();
+  int64_t input_stride_d2 = input.stride(-2);
+  int64_t input_stride_d3 = (num_dims >= 3) ? input.stride(-3) : 0;
+  int64_t input_stride_d4 = (num_dims >= 4) ? input.stride(-4) : 0;
+  int64_t input_shape_d2 = (num_dims >= 3) ? input.size(-2) : 0;
+  int64_t input_shape_d3 = (num_dims >= 4) ? input.size(-3) : 0;
+
+  const int max_block_size = (num_tokens < 256) ? 1024 : 256;
+  dim3 grid(num_tokens);
+  dim3 block(std::min(hidden_size, max_block_size));
+  const at::cuda::OptionalCUDAGuard device_guard(device_of(input));
+  const cudaStream_t stream = at::cuda::getCurrentCUDAStream();
+  VLLM_DISPATCH_RANK234(num_dims, [&] {
+    VLLM_DISPATCH_FLOATING_TYPES(
+        weight.scalar_type(), "heal_rms_norm_fp32_kernel", [&] {
+          vllm::heal_rms_norm_fp32_kernel<scalar_t, tensor_rank>
+              <<<grid, block, 0, stream>>>(
+                  out.data_ptr<float>(), input.data_ptr<float>(),
+                  input_stride_d2, input_stride_d3, input_stride_d4,
+                  input_shape_d2, input_shape_d3, weight.data_ptr<scalar_t>(),
+                  epsilon, num_tokens, hidden_size);
+        });
+  });
+}
+
+void heal_fused_add_rms_norm_fp32(torch::Tensor& input,     // [..., hidden_size]
+                                  torch::Tensor& residual,  // [..., hidden_size]
+                                  torch::Tensor& weight,    // [hidden_size]
+                                  double epsilon) {
+  TORCH_CHECK(input.scalar_type() == at::kFloat,
+              "heal_fused_add_rms_norm_fp32: input must be float32");
+  TORCH_CHECK(residual.scalar_type() == at::kFloat,
+              "heal_fused_add_rms_norm_fp32: residual must be float32");
+  TORCH_CHECK(weight.scalar_type() == at::kFloat ||
+                  weight.scalar_type() == at::kHalf ||
+                  weight.scalar_type() == at::kBFloat16,
+              "heal_fused_add_rms_norm_fp32: weight must be float32, "
+              "float16, or bfloat16");
+  TORCH_CHECK(input.stride(-1) == 1,
+              "heal_fused_add_rms_norm_fp32: input last dimension must be "
+              "contiguous");
+  TORCH_CHECK(residual.is_contiguous(),
+              "heal_fused_add_rms_norm_fp32: residual must be contiguous");
+  TORCH_CHECK(weight.is_contiguous(),
+              "heal_fused_add_rms_norm_fp32: weight must be contiguous");
+  TORCH_CHECK(input.sizes() == residual.sizes(),
+              "heal_fused_add_rms_norm_fp32: input and residual shapes must "
+              "match");
+
+  int hidden_size = input.size(-1);
+  TORCH_CHECK(weight.numel() == hidden_size,
+              "heal_fused_add_rms_norm_fp32: weight size must match hidden "
+              "size");
+  int64_t input_stride = input.stride(-2);
+  int num_tokens = input.numel() / hidden_size;
+
+  dim3 grid(num_tokens);
+  const int max_block_size = (num_tokens < 256) ? 1024 : 256;
+  dim3 block(std::min(hidden_size, max_block_size));
+  const at::cuda::OptionalCUDAGuard device_guard(device_of(input));
+  const cudaStream_t stream = at::cuda::getCurrentCUDAStream();
+  VLLM_DISPATCH_FLOATING_TYPES(
+      weight.scalar_type(), "heal_fused_add_rms_norm_fp32_kernel", [&] {
+        vllm::heal_fused_add_rms_norm_fp32_kernel<scalar_t>
+            <<<grid, block, 0, stream>>>(
+                input.data_ptr<float>(), input_stride,
+                residual.data_ptr<float>(), weight.data_ptr<scalar_t>(),
+                epsilon, num_tokens, hidden_size);
+      });
+}
