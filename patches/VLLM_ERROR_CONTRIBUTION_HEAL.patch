+        _stats_float(act_scale_value),
+    )
+    entry["residual_abs_mean_sum"] = float(entry.get("residual_abs_mean_sum", 0.0)) + (
+        _stats_float(residual_abs.mean()) if residual_abs.numel() else 0.0
+    )
+    entry["residual_rms_sum"] = float(entry.get("residual_rms_sum", 0.0)) + residual_rms
+    entry["q_nonzero_frac_sum"] = float(entry.get("q_nonzero_frac_sum", 0.0)) + (
+        _stats_float((q_activation != 0).to(torch.float32).mean())
+        if q_activation.numel()
+        else 0.0
+    )
+    entry["compensation_rms_sum"] = (
+        float(entry.get("compensation_rms_sum", 0.0)) + compensation_rms
+    )
+    entry["base_rms_sum"] = float(entry.get("base_rms_sum", 0.0)) + base_rms
+    entry["compensation_base_rms_ratio_sum"] = (
+        float(entry.get("compensation_base_rms_ratio_sum", 0.0)) + ratio
+    )
+    if bool((max_abs == 0).all().item()):
+        entry["zero_residual_calls"] = int(entry["zero_residual_calls"]) + 1
