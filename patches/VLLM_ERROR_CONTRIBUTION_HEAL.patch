+    assert key_cache.ndim == 4, "HEAL.2 requires Triton NHD KV cache layout"
+    assert value_cache.ndim == 4, "HEAL.2 requires Triton NHD KV cache layout"
+    assert key.shape[1] == value.shape[1], "K/V head counts must match"
+    assert key.shape[2] == value.shape[2], "K/V head sizes must match"
