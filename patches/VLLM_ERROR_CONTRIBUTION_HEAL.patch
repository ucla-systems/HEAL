+        from vllm.model_executor.layers.quantization.compressed_tensors.triton_scaled_mm import (  # noqa: E501
+            triton_scaled_mm,
+        )
+    except Exception as exc:
+        raise RuntimeError(
+            "HEAL INT8 compensation requires vLLM's triton_scaled_mm helper, "
+            "but it could not be imported."
+        ) from exc
+
+    try:
+        return triton_scaled_mm(
+            q_activation,
+            q_weight_t,
+            act_scale.contiguous(),
+            weight_scale.contiguous(),
+            torch.float32,
+        )
+    except Exception as exc:
+        raise RuntimeError(
+            "HEAL INT8 compensation is unsupported for this scaled_mm call: "
+            f"q_activation={tuple(q_activation.shape)} {q_activation.dtype}, "
+            f"q_weight_t={tuple(q_weight_t.shape)} {q_weight_t.dtype}, "
+            f"act_scale={tuple(act_scale.shape)} {act_scale.dtype}, "
+            f"weight_scale={tuple(weight_scale.shape)} {weight_scale.dtype}."
+        ) from exc
+
+
+def _dynamic_int8_split_weight(
+    weight: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    if weight.ndim != 2 or not torch.is_floating_point(weight):
+        raise RuntimeError(
+            "HEAL dynamic INT8 compensation expects a 2D floating-point "
+            f"weight tensor, got shape={tuple(weight.shape)} dtype={weight.dtype}."
+        )
+    q_weight = torch.empty(weight.shape, device=weight.device, dtype=torch.int8)
+    weight_scale = torch.empty(
+        (weight.shape[0],), device=weight.device, dtype=torch.float32
+    )
+    chunk_rows = _heal_dynamic_int8_gemm_weight_chunk_rows()
+    tiny = torch.finfo(torch.float32).tiny
+    with torch.no_grad():
+        for start in range(0, weight.shape[0], chunk_rows):
+            end = min(start + chunk_rows, weight.shape[0])
+            weight_chunk = weight[start:end].detach()
+            scale = weight_chunk.abs().amax(dim=1).to(torch.float32)
+            scale = scale.clamp_min(tiny).div(127.0)
+            q_chunk = torch.round(
+                weight_chunk.to(torch.float32) / scale[:, None]
+            ).clamp_(-127, 127)
+            q_weight[start:end].copy_(q_chunk.to(torch.int8))
+            weight_scale[start:end].copy_(scale)
+    return q_weight.t(), weight_scale.contiguous()
