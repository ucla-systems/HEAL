+def _int8_split_compensation(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    layer: torch.nn.Module,
+    base: torch.Tensor | None = None,
+) -> torch.Tensor:
+    if x.shape[0] == 0 or weight.shape[0] == 0:
+        return x.new_empty((x.shape[0], weight.shape[0]), dtype=torch.float32)
+
+    if _heal_dynamic_int8_gemm_weight():
+        q_weight_t, weight_scale = _dynamic_int8_split_weight(weight)
+    else:
+        q_weight_t = getattr(layer, "_heal_int8_gemm_weight_t", None)
+        weight_scale = getattr(layer, "_heal_int8_gemm_weight_scale", None)
+        if (
+            q_weight_t is None
+            or weight_scale is None
+            or q_weight_t.shape != (weight.shape[1], weight.shape[0])
+            or q_weight_t.device != weight.device
+        ):
+            _heal_prepare_int8_gemm_weight(layer)
+            q_weight_t = getattr(layer, "_heal_int8_gemm_weight_t", None)
+            weight_scale = getattr(layer, "_heal_int8_gemm_weight_scale", None)
+        if q_weight_t is None or weight_scale is None:
+            _record_int8_split_missing_weight_stats(layer, x, weight)
+            prefix, class_name = _layer_name(layer)
+            raise RuntimeError(
+                "HEAL INT8 compensation is enabled but no prepared INT8 weight "
+                "buffer is available for layer "
+                f"prefix={prefix!r} class={class_name}."
+            )
+
+    x_fp32 = x.to(torch.float32)
+    x_fp16 = x_fp32.to(torch.float16).to(torch.float32)
+    residual = x_fp32 - x_fp16
+    max_abs = residual.abs().amax(dim=1)
+    inv_scale = torch.where(
+        max_abs > 0,
+        max_abs.reciprocal() * 127.0,
+        torch.zeros_like(max_abs),
+    )
+    act_scale = max_abs / 127.0
+    q_activation = torch.round(residual * inv_scale[:, None]).clamp_(-127, 127)
+    q_activation = q_activation.to(torch.int8).contiguous()
+
+    compensation = _int8_split_scaled_mm_fp32(
+        q_activation,
+        q_weight_t,
+        act_scale,
+        weight_scale,
+    )
+    if base is not None:
+        _record_int8_split_stats(
+            layer,
+            x,
+            weight,
+            base,
+            residual,
+            q_activation,
+            compensation,
+            max_abs,
+            act_scale,
+        )
+    return compensation
+
+
+def fp32_output_linear(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    bias: torch.Tensor | None = None,
+    output_scale: float | None = None,
+    layer: torch.nn.Module | None = None,
+) -> torch.Tensor:
+    x_2d = x.reshape(-1, x.shape[-1])
+    if _heal_use_int8_gemm_split(layer):
+        out = blaslt_fp32_gemm(x_2d, weight, None, None)
+        out.add_(_int8_split_compensation(x_2d, weight, layer, out))
+        if output_scale is not None and output_scale != 1.0:
+            out.mul_(1.0 / output_scale)
+        if bias is not None:
+            out.add_(bias.to(torch.float32))
+    else:
+        out = blaslt_fp32_gemm(x_2d, weight, bias, output_scale)
+    return out.reshape(*x.shape[:-1], weight.shape[0])
