diff --git a/vllm/model_executor/layers/blaslt_fp32_gemm.py b/vllm/model_executor/layers/blaslt_fp32_gemm.py
new file mode 100644
index 000000000..97d5f5f36
--- /dev/null
+++ b/vllm/model_executor/layers/blaslt_fp32_gemm.py
@@ -0,0 +1,647 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""FP32-output GEMM helpers for HEAL runs."""
+
+from __future__ import annotations
+
+import atexit
+import json
+import os
+
+import torch
+import torch.nn.functional as F
+
+import vllm._custom_ops as ops
+from vllm.platforms import current_platform
+from vllm.triton_utils import HAS_TRITON, tl, triton
+
+_INT8_SPLIT_STATS: dict[str, dict[str, object]] = {}
+_INT8_SPLIT_STATS_REGISTERED = False
+
+
+def _heal_use_int8_gemm_split(layer: torch.nn.Module | None) -> bool:
+    if layer is None:
+        return False
+    try:
+        from vllm.model_executor.models.heal_runtime import use_int8_gemm_split
+
+        return use_int8_gemm_split(layer)
+    except Exception:
+        return False
+
+
+def _heal_prepare_int8_gemm_weight(layer: torch.nn.Module) -> None:
+    from vllm.model_executor.models.heal_runtime import prepare_int8_gemm_weight
+
+    prepare_int8_gemm_weight(layer)
+
+
+def _heal_dynamic_int8_gemm_weight() -> bool:
+    from vllm.model_executor.models.heal_runtime import (
+        dynamic_int8_gemm_weight_enabled,
+    )
+
+    return dynamic_int8_gemm_weight_enabled()
+
+
+def _heal_dynamic_int8_gemm_weight_chunk_rows() -> int:
+    from vllm.model_executor.models.heal_runtime import (
+        dynamic_int8_gemm_weight_chunk_rows,
+    )
+
+    return dynamic_int8_gemm_weight_chunk_rows()
+
+
+def _allow_triton_fp32_gemm() -> bool:
+    return os.environ.get("HEAL_ALLOW_TRITON_FP32_GEMM", "").lower() in {
+        "1",
+        "true",
+        "yes",
+        "on",
+    }
+
+
+def _int8_split_stats_path() -> str | None:
+    path = os.environ.get("HEAL_INT8_GEMM_STATS_FILE")
+    if not path:
+        return None
+    return path.format(pid=os.getpid())
+
+
+def _int8_split_stats_enabled() -> bool:
+    return _int8_split_stats_path() is not None
+
+
+def _layer_name(layer: torch.nn.Module | None) -> tuple[str, str]:
+    if layer is None:
+        return "", "None"
+    return str(getattr(layer, "prefix", "")), layer.__class__.__name__
+
+
+def _bump_dtype_count(entry: dict[str, object], field: str, dtype: torch.dtype) -> None:
+    counts = entry.setdefault(field, {})
+    assert isinstance(counts, dict)
+    key = str(dtype)
+    counts[key] = int(counts.get(key, 0)) + 1
+
+
+def _stats_float(tensor: torch.Tensor) -> float:
+    return float(tensor.detach().to(torch.float32).item())
+
+
+def _stats_rms(tensor: torch.Tensor) -> float:
+    if tensor.numel() == 0:
+        return 0.0
+    return _stats_float(tensor.detach().to(torch.float32).pow(2).mean().sqrt())
+
+
+def _write_int8_split_stats() -> None:
+    path = _int8_split_stats_path()
+    if not path or not _INT8_SPLIT_STATS:
+        return
+    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
+    totals = {
+        "calls": 0,
+        "rows": 0,
+        "missing_weight_calls": 0,
+        "zero_residual_calls": 0,
+    }
+    layers = []
+    for entry in sorted(
+        _INT8_SPLIT_STATS.values(),
+        key=lambda item: (str(item.get("prefix", "")), str(item.get("class_name", ""))),
+    ):
+        calls = int(entry.get("calls", 0))
+        rows = int(entry.get("rows", 0))
+        totals["calls"] += calls
+        totals["rows"] += rows
+        totals["missing_weight_calls"] += int(entry.get("missing_weight_calls", 0))
+        totals["zero_residual_calls"] += int(entry.get("zero_residual_calls", 0))
+        if calls:
+            for field in (
+                "residual_abs_mean",
+                "residual_rms",
+                "q_nonzero_frac",
+                "compensation_rms",
+                "base_rms",
+                "compensation_base_rms_ratio",
+            ):
+                sum_field = f"{field}_sum"
+                if sum_field in entry:
+                    entry[f"{field}_avg"] = float(entry[sum_field]) / calls
+        layers.append(entry)
+    payload = {
+        "pid": os.getpid(),
+        "version": 1,
+        "totals": totals,
+        "layers": layers,
+    }
+    tmp_path = f"{path}.tmp"
+    with open(tmp_path, "w", encoding="utf-8") as handle:
+        json.dump(payload, handle, indent=2, sort_keys=True)
+    os.replace(tmp_path, path)
+
+
+def _ensure_int8_split_stats_registered() -> None:
+    global _INT8_SPLIT_STATS_REGISTERED
+    if _INT8_SPLIT_STATS_REGISTERED:
+        return
+    atexit.register(_write_int8_split_stats)
+    _INT8_SPLIT_STATS_REGISTERED = True
+
+
+def _int8_split_stats_entry(
+    layer: torch.nn.Module | None,
+    x: torch.Tensor,
+    weight: torch.Tensor,
+) -> dict[str, object] | None:
+    if not _int8_split_stats_enabled():
+        return None
+    _ensure_int8_split_stats_registered()
+    prefix, class_name = _layer_name(layer)
+    key = f"{prefix}\0{class_name}\0{tuple(weight.shape)}"
+    entry = _INT8_SPLIT_STATS.setdefault(
+        key,
+        {
+            "prefix": prefix,
+            "class_name": class_name,
+            "weight_shape": list(weight.shape),
+            "calls": 0,
+            "rows": 0,
+            "m_min": None,
+            "m_max": 0,
+            "k": int(weight.shape[1]),
+            "n": int(weight.shape[0]),
+            "missing_weight_calls": 0,
+            "zero_residual_calls": 0,
+        },
+    )
+    _bump_dtype_count(entry, "x_dtypes", x.dtype)
+    _bump_dtype_count(entry, "weight_dtypes", weight.dtype)
+    return entry
+
+
+def _record_int8_split_stats(
+    layer: torch.nn.Module,
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    base: torch.Tensor,
+    residual: torch.Tensor,
+    q_activation: torch.Tensor,
+    compensation: torch.Tensor,
+    max_abs: torch.Tensor,
+    act_scale: torch.Tensor,
+) -> None:
+    entry = _int8_split_stats_entry(layer, x, weight)
+    if entry is None:
+        return
+    m = int(x.shape[0])
+    entry["calls"] = int(entry["calls"]) + 1
+    entry["rows"] = int(entry["rows"]) + m
+    entry["m_min"] = m if entry["m_min"] is None else min(int(entry["m_min"]), m)
+    entry["m_max"] = max(int(entry["m_max"]), m)
+    residual_abs = residual.detach().abs()
+    residual_rms = _stats_rms(residual)
+    base_rms = _stats_rms(base)
+    compensation_rms = _stats_rms(compensation)
+    ratio = compensation_rms / base_rms if base_rms > 0.0 else 0.0
+    max_abs_value = max_abs.detach().to(torch.float32).amax()
+    act_scale_value = act_scale.detach().to(torch.float32).amax()
