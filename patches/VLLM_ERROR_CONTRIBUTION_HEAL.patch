+
+    key_absmax = tl.max(tl.abs(tl.where(dim_mask, key, 0.0)), axis=0)
+    key_valid = (
+        (key_absmax > 0.0)
+        & (key_absmax < float("inf"))
+        & (key_absmax == key_absmax)
+    )
+    key_scale = tl.where(key_valid, key_absmax / 32767.0, 1.0)
+    q_key = tl.where(key_valid, key / key_scale, 0.0)
+    q_key = tl.minimum(tl.maximum(q_key, -32767.0), 32767.0)
+    q_key = _round_int16(q_key)
+
