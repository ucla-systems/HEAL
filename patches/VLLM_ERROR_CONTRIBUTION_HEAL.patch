+def _record_int8_split_missing_weight_stats(
+    layer: torch.nn.Module,
+    x: torch.Tensor,
+    weight: torch.Tensor,
+) -> None:
+    entry = _int8_split_stats_entry(layer, x, weight)
+    if entry is None:
+        return
+    m = int(x.shape[0])
+    entry["calls"] = int(entry["calls"]) + 1
+    entry["rows"] = int(entry["rows"]) + m
+    entry["m_min"] = m if entry["m_min"] is None else min(int(entry["m_min"]), m)
+    entry["m_max"] = max(int(entry["m_max"]), m)
+    entry["missing_weight_calls"] = int(entry["missing_weight_calls"]) + 1
