@@ -0,0 +1,507 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Significand-rounding hooks for local experiments.
+
+The rounding intervention is env-gated, while the implementation version always
+uses the full FP32 LayerCast workflow for the significand sweep.
+"""
+
+from __future__ import annotations
+
+import os
+import math
+import logging
+
+import torch
+
+logger = logging.getLogger(__name__)
+
+_SIGNIFICAND_BITS_MIN = 3
+_SIGNIFICAND_BITS_MAX = 23
+_VALID_BOUNDARY_SETS = frozenset(
+    {
+        "all",
+        "linear_outputs",
+        "embedding_outputs",
+        "rmsnorm_outputs",
+        "activation_outputs",
+        "operator_outputs",
+        "attention_qk",
+        "attention_qkv",
+        "attention_v",
+        "attention_outputs",
+        "attention_boundaries",
+    }
+)
+
+
+def _configure_float32_matmul_precision() -> None:
+    os.environ["VLLM_LAYERCAST_FORCE_FP32"] = "1"
+    os.environ["VLLM_FLOAT32_MATMUL_PRECISION"] = "highest"
+    os.environ["TORCH_ALLOW_TF32_CUBLAS_OVERRIDE"] = "0"
+    try:
+        torch.set_float32_matmul_precision("highest")
+    except Exception:
+        pass
+    try:
+        torch.backends.cuda.matmul.allow_tf32 = False
+        torch.backends.cudnn.allow_tf32 = False
+    except Exception:
+        pass
+
+
+_configure_float32_matmul_precision()
+
+
+def _parse_significand_bits() -> int | None:
+    raw = os.environ.get("VLLM_SIGNIFICAND_BITS")
+    if raw is None:
+        return None
+    try:
+        bits = int(raw)
+    except ValueError:
+        raise ValueError(
+            "VLLM_SIGNIFICAND_BITS must be an integer in the range "
+            f"[{_SIGNIFICAND_BITS_MIN}, {_SIGNIFICAND_BITS_MAX}]"
+        ) from None
+    if bits < _SIGNIFICAND_BITS_MIN or bits > _SIGNIFICAND_BITS_MAX:
+        raise ValueError(
+            "VLLM_SIGNIFICAND_BITS must be in the range "
+            f"[{_SIGNIFICAND_BITS_MIN}, {_SIGNIFICAND_BITS_MAX}]"
+        )
+    return bits
+
+
+_SIGNIFICAND_BITS = _parse_significand_bits()
+
+_ROUND_CHUNK_ROWS_DEFAULT = 32
+
+
+def _parse_round_chunk_rows() -> int:
+    raw = os.environ.get(
+        "VLLM_SIGNIFICAND_ROUND_CHUNK_ROWS", str(_ROUND_CHUNK_ROWS_DEFAULT)
+    )
+    try:
+        rows = int(raw)
+    except ValueError:
+        raise ValueError(
+            "VLLM_SIGNIFICAND_ROUND_CHUNK_ROWS must be a positive integer"
+        ) from None
+    if rows <= 0:
+        raise ValueError(
+            "VLLM_SIGNIFICAND_ROUND_CHUNK_ROWS must be a positive integer"
+        )
+    return rows
+
+
+_ROUND_CHUNK_ROWS = _parse_round_chunk_rows()
+
+
+def _parse_skip_channel_percent() -> float:
+    raw = os.environ.get("VLLM_SIGNIFICAND_SKIP_CHANNEL_PERCENT")
+    if raw is None:
+        return 0.0
+    percent = float(raw)
+    if percent < 0.0 or percent > 100.0:
+        raise ValueError(
+            "VLLM_SIGNIFICAND_SKIP_CHANNEL_PERCENT must be in the range [0, 100]"
+        )
+    return percent
+
+
+_SKIP_CHANNEL_FILE = os.environ.get("VLLM_SIGNIFICAND_SKIP_CHANNEL_FILE", "")
+_SKIP_CHANNEL_PERCENT = _parse_skip_channel_percent()
+_SKIP_CHANNEL_METRIC = os.environ.get(
+    "VLLM_SIGNIFICAND_SKIP_CHANNEL_METRIC", "absmax"
+).lower()
+if _SKIP_CHANNEL_METRIC in {"max", "abs_max"}:
+    _SKIP_CHANNEL_METRIC = "absmax"
+if _SKIP_CHANNEL_METRIC in {"sqmean", "mean_square"}:
+    _SKIP_CHANNEL_METRIC = "mean_square"
+if _SKIP_CHANNEL_METRIC not in {"absmax", "mean_square", "square_sum"}:
+    raise ValueError(
+        "VLLM_SIGNIFICAND_SKIP_CHANNEL_METRIC must be 'absmax', "
+        "'mean_square', or 'square_sum'"
+    )
+_SKIP_CHANNEL_MASKS: dict[str, torch.Tensor] | None = None
+_SKIP_CHANNEL_DEVICE_MASKS: dict[tuple[str, torch.device], torch.Tensor] = {}
+
+
+def _parse_boundary_sets() -> frozenset[str]:
+    raw = os.environ.get("VLLM_SIGNIFICAND_BOUNDARY_SET", "all")
+    normalized = raw.lower().replace("+", ",").replace(";", ",").replace(" ", ",")
+    values = frozenset(value for value in normalized.split(",") if value)
+    values = values or frozenset({"all"})
+    unknown = values - _VALID_BOUNDARY_SETS
+    if unknown:
+        raise ValueError(
+            "Unknown VLLM_SIGNIFICAND_BOUNDARY_SET values: "
+            f"{', '.join(sorted(unknown))}. Valid values are: "
+            f"{', '.join(sorted(_VALID_BOUNDARY_SETS))}"
+        )
+    return values
+
+
+_BOUNDARY_SETS = _parse_boundary_sets()
+
+
+def _boundary_set_matches(*names: str) -> bool:
+    return bool(_BOUNDARY_SETS & set(names))
+
+
+def _is_layer_boundary(name: str, suffix: str) -> bool:
+    if not name.endswith(f".{suffix}") or not name.startswith("layer_"):
+        return False
+    layer_id, separator, _ = name[len("layer_"):].partition(".")
+    return bool(separator) and layer_id.isdigit()
+
+
+def _is_linear_output(name: str) -> bool:
+    return (
+        any(
+            _is_layer_boundary(name, suffix)
+            for suffix in (
+                "mlp.gate_up_proj.output",
+                "mlp.down_proj.output",
+                "self_attn.o_proj.output",
+                "self_attn.qkv_proj.output.q",
+                "self_attn.qkv_proj.output.k",
+                "self_attn.qkv_proj.output.v",
+            )
+        )
+    )
+
+
+def _is_embedding_output(name: str) -> bool:
+    return name == "forward.embed_tokens.output"
+
+
+def _is_rmsnorm_output(name: str) -> bool:
+    return (
+        name == "forward.norm.hidden"
+        or _is_layer_boundary(name, "input_layernorm.output.hidden")
+        or _is_layer_boundary(name, "input_layernorm.output.residual")
+        or _is_layer_boundary(name, "post_attention_layernorm.output.hidden")
+        or _is_layer_boundary(name, "post_attention_layernorm.output.residual")
+        or _is_layer_boundary(name, "self_attn.q_norm.output")
+        or _is_layer_boundary(name, "self_attn.k_norm.output")
+    )
+
+
+def _is_activation_output(name: str) -> bool:
+    return _is_layer_boundary(name, "mlp.silu_and_mul.output")
+
+
+def _is_attention_boundary(name: str, suffix: str) -> bool:
+    return _is_layer_boundary(name, suffix)
+
+
+def _is_attention_q_boundary(name: str) -> bool:
+    return _is_attention_boundary(name, "self_attn.qkv_proj.output.q")
+
+
+def _is_attention_k_boundary(name: str) -> bool:
+    return _is_attention_boundary(name, "self_attn.qkv_proj.output.k")
+
+
+def _is_attention_v_boundary(name: str) -> bool:
+    return _is_attention_boundary(name, "self_attn.qkv_proj.output.v")
+
+
+def _is_attention_output_boundary(name: str) -> bool:
+    return _is_attention_boundary(name, "self_attn.attention.output")
+
+
+def _is_rotary_q_boundary(name: str) -> bool:
+    return _is_attention_boundary(name, "self_attn.rotary_emb.output.q")
+
+
+def _is_rotary_k_boundary(name: str) -> bool:
+    return _is_attention_boundary(name, "self_attn.rotary_emb.output.k")
+
+
+def _is_rotary_output(name: str) -> bool:
+    return _is_rotary_q_boundary(name) or _is_rotary_k_boundary(name)
+
+
+def _is_known_boundary(name: str) -> bool:
+    return (
+        _is_linear_output(name)
+        or _is_embedding_output(name)
+        or _is_rmsnorm_output(name)
+        or _is_activation_output(name)
+        or _is_rotary_output(name)
+        or _is_attention_output_boundary(name)
+    )
+
+
+def _env_enabled(name: str) -> bool:
+    return os.environ.get(name, "").lower() in {"1", "true", "yes", "on"}
+
+
+def layercast_enabled() -> bool:
+    return _env_enabled("VLLM_LAYERCAST_FORCE_FP32")
+
+
+def significand_rounding_enabled() -> bool:
+    return _SIGNIFICAND_BITS is not None and _SIGNIFICAND_BITS < 23
+
+
+def _pick_sorted_indices(row: object) -> torch.Tensor | None:
+    if not isinstance(row, dict):
+        return None
+    candidate_keys = (
+        f"{_SKIP_CHANNEL_METRIC}_indices",
+        f"rank_{_SKIP_CHANNEL_METRIC}_desc",
+        f"{_SKIP_CHANNEL_METRIC}_desc_indices",
+    )
+    for key in candidate_keys:
+        indices = row.get(key)
+        if torch.is_tensor(indices):
+            return indices.to(torch.long).reshape(-1).cpu()
+    values = row.get(_SKIP_CHANNEL_METRIC)
+    if torch.is_tensor(values):
+        return torch.argsort(values.reshape(-1).to(torch.float32), descending=True).cpu()
+    return None
+
+
+def _load_skip_channel_masks() -> dict[str, torch.Tensor]:
+    if not _SKIP_CHANNEL_FILE or _SKIP_CHANNEL_PERCENT <= 0.0:
+        return {}
+    payload = torch.load(_SKIP_CHANNEL_FILE, map_location="cpu")
+    if isinstance(payload, dict) and "stats" in payload:
+        payload = payload["stats"]
+    if not isinstance(payload, dict):
+        raise ValueError("significand skip-channel file must contain a dict payload")
+
+    masks: dict[str, torch.Tensor] = {}
+    unknown_names: list[str] = []
+    for name, row in payload.items():
+        stage = str(name)
+        if not _is_known_boundary(stage):
+            unknown_names.append(stage)
+            continue
+        indices = _pick_sorted_indices(row)
+        if indices is None or indices.numel() == 0:
+            continue
+        count = int(indices.numel())
+        keep = int(math.ceil(count * _SKIP_CHANNEL_PERCENT / 100.0))
+        if keep <= 0:
+            continue
+        mask = torch.zeros(count, dtype=torch.bool)
+        mask[indices[:keep]] = True
+        masks[stage] = mask
+    if unknown_names:
+        preview = ", ".join(sorted(unknown_names)[:8])
+        suffix = "" if len(unknown_names) <= 8 else f", ... (+{len(unknown_names) - 8})"
+        logger.warning(
+            "Ignoring %d unknown stage names in significand skip-channel file %s: %s%s",
+            len(unknown_names),
+            _SKIP_CHANNEL_FILE,
+            preview,
+            suffix,
+        )
+    if not masks:
+        raise ValueError(
+            "VLLM_SIGNIFICAND_SKIP_CHANNEL_PERCENT is greater than 0 but no "
+            "usable canonical boundary masks were loaded from "
+            f"{_SKIP_CHANNEL_FILE!r}"
+        )
+    return masks
+
+
+def initialize_significand_runtime() -> None:
+    global _SKIP_CHANNEL_MASKS
+    _configure_float32_matmul_precision()
+    if _SKIP_CHANNEL_MASKS is None:
+        _SKIP_CHANNEL_MASKS = _load_skip_channel_masks()
+
+
+def _skip_channel_mask(name: str, x: torch.Tensor) -> torch.Tensor | None:
+    if _SKIP_CHANNEL_MASKS is None:
+        return None
+    mask = _SKIP_CHANNEL_MASKS.get(name)
+    if mask is None:
+        if _SKIP_CHANNEL_FILE and _SKIP_CHANNEL_PERCENT > 0.0:
+            raise ValueError(
+                "Missing skip-channel outlier stats for rounded boundary "
+                f"{name!r} in {_SKIP_CHANNEL_FILE!r}"
+            )
+        return None
+    if mask.numel() != x.shape[-1]:
+        if _SKIP_CHANNEL_FILE and _SKIP_CHANNEL_PERCENT > 0.0:
+            raise ValueError(
+                "Skip-channel mask width mismatch for boundary "
+                f"{name!r}: mask has {mask.numel()} channels but tensor has "
+                f"{x.shape[-1]}"
+            )
+        return None
+    key = (name, x.device)
+    device_mask = _SKIP_CHANNEL_DEVICE_MASKS.get(key)
+    if device_mask is None:
+        device_mask = mask.to(device=x.device)
+        _SKIP_CHANNEL_DEVICE_MASKS[key] = device_mask
+    return device_mask.view(*([1] * (x.ndim - 1)), device_mask.numel())
+
+
+def _boundary_enabled(name: str) -> bool:
+    if "all" in _BOUNDARY_SETS:
+        return _is_known_boundary(name)
+    if _boundary_set_matches("operator_outputs"):
+        if (
+            _is_linear_output(name)
+            or _is_embedding_output(name)
+            or _is_rmsnorm_output(name)
+            or _is_activation_output(name)
+            or _is_rotary_output(name)
+        ):
+            return True
+    if _boundary_set_matches("linear_outputs"):
+        if _is_linear_output(name):
+            return True
+    if _boundary_set_matches("embedding_outputs"):
+        if _is_embedding_output(name):
+            return True
+    if _boundary_set_matches("rmsnorm_outputs"):
+        if _is_rmsnorm_output(name):
+            return True
+    if _boundary_set_matches("activation_outputs"):
+        if _is_activation_output(name):
+            return True
+    if _boundary_set_matches("attention_boundaries"):
+        if (
+            _is_attention_q_boundary(name)
+            or _is_attention_k_boundary(name)
+            or _is_attention_v_boundary(name)
+            or _is_rotary_output(name)
+            or _is_attention_output_boundary(name)
+        ):
+            return True
+    if _boundary_set_matches("attention_qkv"):
+        if (
+            _is_attention_q_boundary(name)
+            or _is_attention_k_boundary(name)
+            or _is_attention_v_boundary(name)
+        ):
+            return True
+    if _boundary_set_matches("attention_qk"):
+        if (
+            _is_attention_q_boundary(name)
+            or _is_attention_k_boundary(name)
+            or _is_rotary_output(name)
+        ):
+            return True
+    if _boundary_set_matches("attention_v"):
+        if _is_attention_v_boundary(name):
+            return True
+    if _boundary_set_matches("attention_outputs"):
+        if _is_attention_output_boundary(name):
+            return True
+    return False
+
+
+def _can_view_as_rows(x: torch.Tensor) -> bool:
+    if x.ndim <= 2:
+        return True
+    for dim in range(x.ndim - 1):
+        if x.size(dim + 1) != 1 and x.stride(dim) != (
+            x.stride(dim + 1) * x.size(dim + 1)
+        ):
+            return False
+    return True
+
+
+def _view_as_rounding_rows(x: torch.Tensor) -> torch.Tensor | None:
+    if x.ndim == 0:
+        return x.reshape(1, 1)
+    if not _can_view_as_rows(x):
+        return None
+    return x.view(-1, x.shape[-1])
+
+
+def _round_significand_chunk(
+    chunk: torch.Tensor,
+    bits: int,
+    original_dtype: torch.dtype,
+    skip_mask: torch.Tensor | None,
+) -> torch.Tensor:
+    y = chunk if chunk.dtype == torch.float32 else chunk.to(torch.float32)
+    finite_nonzero = torch.isfinite(y) & (y != 0)
+    mantissa, exponent = torch.frexp(y)
+    scale = 2.0 ** (bits + 1)
+    mantissa.mul_(scale).round_().div_(scale)
+    rounded = torch.ldexp(mantissa, exponent)
+    rounded = torch.where(finite_nonzero, rounded, y)
+    if skip_mask is not None:
+        rounded = torch.where(skip_mask, y, rounded)
+    return rounded.to(original_dtype)
+
+
+def _rounding_chunk_rows(name: str, row_count: int) -> int:
+    if name in {"lm_head.linear.logits", "forward.logits"}:
+        return min(_ROUND_CHUNK_ROWS, row_count)
+    return row_count
+
+
+def _is_torch_compiling() -> bool:
+    try:
+        return bool(torch.compiler.is_compiling())
+    except AttributeError:
+        return bool(torch._dynamo.is_compiling())
+
+
+def _round_significand_rows_into(
+    name: str,
+    src: torch.Tensor,
+    dst: torch.Tensor,
+    bits: int,
+    original_dtype: torch.dtype,
+    skip_mask: torch.Tensor | None,
+) -> None:
+    rows = _view_as_rounding_rows(src)
+    if rows is None:
+        for index in range(src.shape[0]):
+            _round_significand_rows_into(
+                name, src[index], dst[index], bits, original_dtype, skip_mask
+            )
+        return
+
+    dst_rows = _view_as_rounding_rows(dst)
+    assert dst_rows is not None
+    if _is_torch_compiling():
+        dst_rows.copy_(
+            _round_significand_chunk(rows, bits, original_dtype, skip_mask)
+        )
+        return
+    chunk_rows = _rounding_chunk_rows(name, rows.shape[0])
+    for start in range(0, rows.shape[0], chunk_rows):
+        end = min(start + chunk_rows, rows.shape[0])
+        dst_rows[start:end].copy_(
+            _round_significand_chunk(
+                rows[start:end], bits, original_dtype, skip_mask
+            )
+        )
+
+
+def significand_round_boundary(name: str, x: torch.Tensor) -> torch.Tensor:
+    if not torch.is_floating_point(x):
+        return x
+
+    bits = _SIGNIFICAND_BITS
+    if (
+        bits is None
+        or bits >= 23
+        or not _boundary_enabled(name)
+    ):
+        return x
+
+    original_dtype = x.dtype
+    rounded = torch.empty(x.shape, dtype=original_dtype, device=x.device)
+
+    skip_mask = None
+    if x.ndim > 0:
+        skip_mask = _skip_channel_mask(name, x)
+        if skip_mask is not None:
+            skip_mask = skip_mask.reshape(1, skip_mask.numel())
+
+    _round_significand_rows_into(name, x, rounded, bits, original_dtype, skip_mask)
+    return rounded
