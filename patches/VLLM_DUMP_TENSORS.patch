new file mode 100644
index 000000000..53404b45c
--- /dev/null
+++ b/vllm/model_executor/models/tensor_trace.py
@@ -0,0 +1,316 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Small env-gated tensor tracing hooks for local precision benchmarks."""
+
+from __future__ import annotations
+
+import json
+import os
+import re
+from collections.abc import Iterable
+from pathlib import Path
+
+import torch
+from safetensors.torch import save_file
+
+_TENSORS: dict[str, list[torch.Tensor]] = {}
+_OUTLIER_STATS: dict[str, dict[str, torch.Tensor | int]] = {}
+_DUMP_MODE_CHOICES = {"everything", "qkv", "outlier"}
+_TOKEN_INDEX_FILTER_OVERRIDE: tuple[bool, tuple[int, ...]] | None = None
+_ROW_FILTER_WARNED: set[str] = set()
+
+
+def _tensor_file() -> str:
+    return os.environ.get("TENSOR_TRACE_TENSOR_FILE") or os.environ.get(
+        "VLLM_TENSOR_TRACE_TENSOR_FILE", ""
+    )
+
+
+def tensor_trace_enabled() -> bool:
+    return bool(_tensor_file())
+
+
+def _stage_enabled(stage: str) -> bool:
+    pattern = os.environ.get("TENSOR_TRACE_STAGE_REGEX") or os.environ.get(
+        "VLLM_TENSOR_TRACE_STAGE_REGEX", ""
+    )
+    if not pattern:
+        return True
+    return re.search(pattern, stage) is not None
+
+
+def _parse_token_index_filter(
+    value: str | Iterable[int],
+    *,
+    source: str,
+) -> tuple[bool, tuple[int, ...]]:
+    token_indices = []
+    seen = set()
+    if isinstance(value, str):
+        raw_items = re.split(r"[,;+\s]+", value.strip())
+    else:
+        raw_items = list(value)
+
+    for item in raw_items:
+        if item == "":
+            continue
+        try:
+            token_index = int(item)
+        except (TypeError, ValueError) as exc:
+            raise ValueError(
+                f"{source} must be a comma/space-separated list or iterable "
+                f"of integer token row indices; got {item!r}"
+            ) from exc
+        if token_index < 0:
+            raise ValueError(f"{source} does not support negative indices")
+        if token_index in seen:
+            continue
+        seen.add(token_index)
+        token_indices.append(token_index)
+    return True, tuple(token_indices)
+
+
+def set_tensor_trace_token_index_filter(
+    token_indices: str | Iterable[int] | None,
+) -> None:
+    """Set the optional token-row filter from runner/external code.
+
+    Indices are zero-based over each captured tensor's first dimension.
+    ``None`` disables row filtering. An empty string/list keeps the filter
+    enabled but records no token rows.
+    """
+
+    global _TOKEN_INDEX_FILTER_OVERRIDE
+    if token_indices is None:
+        _TOKEN_INDEX_FILTER_OVERRIDE = (False, ())
+        return
+    _TOKEN_INDEX_FILTER_OVERRIDE = _parse_token_index_filter(
+        token_indices,
+        source="set_tensor_trace_token_index_filter",
+    )
+
+
+def clear_tensor_trace_token_index_filter_override() -> None:
+    global _TOKEN_INDEX_FILTER_OVERRIDE
+    _TOKEN_INDEX_FILTER_OVERRIDE = None
+
+
+def _token_index_filter() -> tuple[bool, tuple[int, ...]]:
+    if _TOKEN_INDEX_FILTER_OVERRIDE is not None:
+        return _TOKEN_INDEX_FILTER_OVERRIDE
+    for env_name in (
+        "VLLM_DUMP_TENSORS_TOKEN_INDICES",
+        "TENSOR_TRACE_TOKEN_INDICES",
+        "VLLM_TENSOR_TRACE_TOKEN_INDICES",
+    ):
+        if env_name in os.environ:
+            return _parse_token_index_filter(os.environ[env_name], source=env_name)
+    return False, ()
+
+
+def _dump_modes() -> frozenset[str]:
+    raw = (
+        os.environ.get("VLLM_DUMP_TENSORS_MODE")
+        or os.environ.get("TENSOR_TRACE_DUMP_TENSORS_MODE")
+        or "everything"
+    ).lower()
+    modes = {item for item in re.split(r"[,;+\s]+", raw) if item}
+    if not modes:
+        modes = {"everything"}
+    unknown = modes - _DUMP_MODE_CHOICES
+    if unknown:
+        raise ValueError(
+            "VLLM_DUMP_TENSORS_MODE supports only "
+            f"{sorted(_DUMP_MODE_CHOICES)}; got {sorted(unknown)}"
+        )
+    if len(modes) != 1:
+        raise ValueError("VLLM_DUMP_TENSORS_MODE must select exactly one mode")
+    return frozenset(modes)
+
+
+def _outlier_only_enabled() -> bool:
+    modes = _dump_modes()
+    return "outlier" in modes and not ({"everything", "qkv"} & modes)
+
+
+def dump_tensors_mode_enabled(mode: str) -> bool:
+    modes = _dump_modes()
+    if mode == "qkv":
+        return bool({"qkv", "everything"} & modes)
+    if mode == "everything":
+        return "everything" in modes
+    return mode in modes
+
+
+def clear_tensor_trace_tensors() -> None:
+    _TENSORS.clear()
+    _OUTLIER_STATS.clear()
+    _ROW_FILTER_WARNED.clear()
+
+
+def _warn_row_filter_once(stage: str, reason: str) -> None:
+    key = f"{stage}:{reason}"
+    if key in _ROW_FILTER_WARNED:
+        return
+    _ROW_FILTER_WARNED.add(key)
+    import warnings
+
+    warnings.warn(
+        f"Skipping tensor trace row filter for {stage}: {reason}",
+        RuntimeWarning,
+        stacklevel=3,
+    )
+
+
+def _select_tensor_trace_rows(
+    stage: str,
+    tensor: torch.Tensor,
+) -> torch.Tensor | None:
+    enabled, token_indices = _token_index_filter()
+    if not enabled:
+        return tensor
+    if not token_indices:
+        return None
+    if tensor.ndim == 0:
+        _warn_row_filter_once(stage, "scalar tensor has no token row dimension")
+        return None
+    valid_indices = [idx for idx in token_indices if idx < tensor.shape[0]]
+    if not valid_indices:
+        return None
+
+    indices = torch.tensor(valid_indices, dtype=torch.long, device=tensor.device)
+    return tensor.index_select(0, indices)
+
+
+def record_tensor_trace_tensor(stage: str, tensor: torch.Tensor) -> torch.Tensor:
+    if not tensor_trace_enabled() or _outlier_only_enabled() or not _stage_enabled(stage):
+        return tensor
+    if not torch.is_tensor(tensor):
+        return tensor
+    with torch.no_grad():
+        captured = tensor.detach()
+        captured = _select_tensor_trace_rows(stage, captured)
+        if captured is None:
+            return tensor
+        if torch.is_floating_point(captured):
+            captured = captured.to(torch.float32)
+        captured = captured.cpu().contiguous().clone()
+    _TENSORS.setdefault(stage, []).append(captured)
+    return tensor
+
+
+def _record_outlier_tensor(stage: str, tensor: torch.Tensor) -> None:
+    if not tensor_trace_enabled() or not _stage_enabled(stage):
+        return
+    if not torch.is_tensor(tensor) or not torch.is_floating_point(tensor):
+        return
+    with torch.no_grad():
+        captured = _select_tensor_trace_rows(stage, tensor.detach())
+        if captured is None:
+            return
+        captured = captured.to(torch.float32)
+        if captured.ndim == 0:
+            rows = captured.reshape(1, 1)
+        else:
+            rows = captured.reshape(-1, captured.shape[-1])
+        absmax = rows.abs().amax(dim=0).cpu()
+        square_sum = rows.square().sum(dim=0).cpu()
+        count = rows.shape[0]
+
+    stats = _OUTLIER_STATS.get(stage)
+    if stats is None:
+        _OUTLIER_STATS[stage] = {
+            "absmax": absmax,
+            "square_sum": square_sum,
+            "count": int(count),
+        }
+        return
+    stats["absmax"] = torch.maximum(stats["absmax"], absmax)  # type: ignore[arg-type]
+    stats["square_sum"] = stats["square_sum"] + square_sum  # type: ignore[operator]
+    stats["count"] = int(stats["count"]) + int(count)
+
+
+def record_dump_tensor(
+    mode: str,
+    stage: str,
+    tensor: torch.Tensor,
+) -> torch.Tensor:
+    modes = _dump_modes()
+    if "outlier" in modes and mode in {"everything", "qkv"}:
+        _record_outlier_tensor(stage, tensor)
+    if dump_tensors_mode_enabled(mode):
+        return record_tensor_trace_tensor(stage, tensor)
+    return tensor
+
+
+def _payload_and_metadata() -> tuple[dict[str, torch.Tensor], dict[str, object]]:
+    payload: dict[str, torch.Tensor] = {}
+    metadata: dict[str, object] = {}
+    for stage, chunks in _TENSORS.items():
+        stage_rows = []
+        for idx, tensor in enumerate(chunks):
+            key = f"{stage}__chunk_{idx:06d}" if len(chunks) > 1 else stage
+            payload[key] = tensor
+            stage_rows.append(
+                {
+                    "key": key,
+                    "shape": list(tensor.shape),
+                    "dtype": str(tensor.dtype),
+                }
+            )
+        metadata[stage] = stage_rows
+    return payload, metadata
+
+
+def _outlier_payload() -> dict[str, object]:
+    payload: dict[str, object] = {"schema_version": 1, "stats": {}}
+    stats_payload: dict[str, dict[str, torch.Tensor]] = {}
+    for stage, stats in _OUTLIER_STATS.items():
+        count = torch.tensor(int(stats["count"]), dtype=torch.long)
+        square_sum = stats["square_sum"]  # type: ignore[assignment]
+        mean_square = square_sum / torch.clamp(count.to(torch.float32), min=1.0)
+        absmax = stats["absmax"]  # type: ignore[assignment]
+        stats_payload[stage] = {
+            "absmax": absmax,
+            "square_sum": square_sum,
+            "mean_square": mean_square,
+            "count": count,
+            "absmax_indices": torch.argsort(absmax, descending=True),
+            "square_sum_indices": torch.argsort(square_sum, descending=True),
+            "mean_square_indices": torch.argsort(mean_square, descending=True),
+        }
+    payload["stats"] = stats_payload
+    return payload
+
+
+def _outlier_file_path(path: Path, has_raw_payload: bool) -> Path:
+    if has_raw_payload:
+        suffix = path.suffix + ".outlier.pt" if path.suffix else ".outlier.pt"
+        return path.with_suffix(suffix)
+    if path.suffix == ".pt":
+        return path
+    suffix = path.suffix + ".pt" if path.suffix else ".pt"
+    return path.with_suffix(suffix)
+
+
+def flush_tensor_trace_tensors(
+    tensor_file: str | os.PathLike[str] | None = None,
+) -> None:
