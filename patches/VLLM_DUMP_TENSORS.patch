+def _layercast_model_init_dtype(dtype: torch.dtype) -> torch.dtype:
+    enabled = os.environ.get("VLLM_LAYERCAST_FORCE_FP32", "").lower()
+    if enabled in {"1", "true", "yes", "on"} and dtype is torch.float32:
+        return torch.bfloat16
+    return dtype
+
+
+def _restore_layercast_buffer_dtype(model: nn.Module, dtype: torch.dtype) -> None:
+    enabled = os.environ.get("VLLM_LAYERCAST_FORCE_FP32", "").lower()
+    if enabled not in {"1", "true", "yes", "on"}:
+        return
+    for module in model.modules():
+        if isinstance(getattr(module, "dtype", None), torch.dtype):
+            module.dtype = dtype
+        buffer = getattr(module, "cos_sin_cache", None)
+        if (
+            isinstance(buffer, torch.Tensor)
+            and buffer.dtype != dtype
+            and hasattr(module, "_compute_cos_sin_cache")
+        ):
+            cache = module._compute_cos_sin_cache()
+            if not getattr(module, "use_flashinfer", False):
+                cache = cache.to(dtype=dtype)
+            cache = cache.to(device=buffer.device)
+            module._buffers["cos_sin_cache"] = cache
+        for name, buffer in module.named_buffers(recurse=False):
+            if buffer is not None and torch.is_floating_point(buffer):
+                module._buffers[name] = buffer.to(dtype=dtype)
+
+
