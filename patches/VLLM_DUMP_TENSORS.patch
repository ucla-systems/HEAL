diff --git a/vllm/model_executor/models/layercast_runtime.py b/vllm/model_executor/models/layercast_runtime.py
new file mode 100644
index 000000000..1c76441d5
--- /dev/null
+++ b/vllm/model_executor/models/layercast_runtime.py
@@ -0,0 +1,36 @@
+# SPDX-License-Identifier: Apache-2.0
+"""LayerCast runtime gates for local tensor-dump experiments."""
+
+from __future__ import annotations
+
+import os
+
+import torch
+
+
+def _env_enabled(name: str) -> bool:
+    return os.environ.get(name, "").lower() in {"1", "true", "yes", "on"}
+
+
+def _configure_float32_matmul_precision() -> None:
+    raw_precision = os.environ.get("VLLM_FLOAT32_MATMUL_PRECISION")
+    raw_tf32 = os.environ.get("TORCH_ALLOW_TF32_CUBLAS_OVERRIDE")
+    if raw_precision:
+        try:
+            torch.set_float32_matmul_precision(raw_precision)
+        except Exception:
+            pass
+    if raw_tf32 is not None:
+        try:
+            allow_tf32 = raw_tf32.lower() in {"1", "true", "yes", "on"}
+            torch.backends.cuda.matmul.allow_tf32 = allow_tf32
+            torch.backends.cudnn.allow_tf32 = allow_tf32
+        except Exception:
+            pass
+
+
+_configure_float32_matmul_precision()
+
+
+def layercast_enabled() -> bool:
+    return _env_enabled("VLLM_LAYERCAST_FORCE_FP32")
