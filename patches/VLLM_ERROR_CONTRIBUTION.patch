+# SPDX-License-Identifier: Apache-2.0
+"""Small env-gated tensor tracing hooks for local precision benchmarks."""
+
+from __future__ import annotations
+
+import json
+import os
+import re
+from pathlib import Path
+from typing import Any
+
+import torch
+from safetensors.torch import save_file
+
+_TENSORS: dict[str, list[torch.Tensor]] = {}
+_TENSOR_METADATA: dict[str, list[dict[str, object]]] = {}
+_ROW_METADATA: dict[str, object] | None = None
+_ROW_METADATA_LIST_KEYS = {
+    "row_request_indices",
+    "row_token_positions",
+    "row_token_ids",
+}
+
+
+def _tensor_file() -> str:
+    return os.environ.get("TENSOR_TRACE_TENSOR_FILE") or os.environ.get(
+        "VLLM_TENSOR_TRACE_TENSOR_FILE", ""
+    )
+
+
+def tensor_trace_enabled() -> bool:
+    return bool(_tensor_file())
+
+
+def _stage_enabled(stage: str) -> bool:
+    pattern = os.environ.get("TENSOR_TRACE_STAGE_REGEX") or os.environ.get(
+        "VLLM_TENSOR_TRACE_STAGE_REGEX", ""
+    )
+    if not pattern:
+        return True
+    return re.search(pattern, stage) is not None
+
+
+def set_tensor_trace_row_metadata(metadata: dict[str, Any] | None) -> None:
+    global _ROW_METADATA
+    _ROW_METADATA = dict(metadata) if metadata is not None else None
+
+
+def clear_tensor_trace_row_metadata() -> None:
+    global _ROW_METADATA
+    _ROW_METADATA = None
+
+
+def clear_tensor_trace_tensors() -> None:
+    _TENSORS.clear()
+    _TENSOR_METADATA.clear()
+    clear_tensor_trace_row_metadata()
+
+
+def _row_metadata_for_tensor(row_count: int) -> dict[str, object] | None:
+    if _ROW_METADATA is None:
+        return None
+    metadata: dict[str, object] = {}
+    for key, value in _ROW_METADATA.items():
+        if key not in _ROW_METADATA_LIST_KEYS:
+            metadata[key] = value
+            continue
+        if not isinstance(value, list):
+            metadata[key] = value
+            continue
+        metadata[key] = value[:row_count]
+        if len(value) < row_count:
+            metadata.setdefault("metadata_row_mismatches", []).append(
+                {
+                    "key": key,
+                    "available_rows": len(value),
+                    "tensor_rows": row_count,
+                }
+            )
+    metadata["row_count"] = int(row_count)
+    return metadata
+
+
+def record_tensor_trace_tensor(stage: str, tensor: torch.Tensor) -> torch.Tensor:
+    if not tensor_trace_enabled() or not _stage_enabled(stage):
+        return tensor
+    if not torch.is_tensor(tensor):
+        return tensor
+    with torch.no_grad():
+        captured = tensor.detach()
+        if torch.is_floating_point(captured):
+            captured = captured.to(torch.float32)
+        captured = captured.cpu().contiguous().clone()
+    _TENSORS.setdefault(stage, []).append(captured)
+    if captured.ndim >= 1:
+        row_metadata = _row_metadata_for_tensor(int(captured.shape[0]))
+        if row_metadata is not None:
+            _TENSOR_METADATA.setdefault(stage, []).append(row_metadata)
+    return tensor
+
+
+def _payload_and_metadata() -> tuple[dict[str, torch.Tensor], dict[str, object]]:
+    payload: dict[str, torch.Tensor] = {}
+    metadata: dict[str, object] = {}
+    for stage, chunks in _TENSORS.items():
+        stage_rows = []
+        stage_row_metadata = _TENSOR_METADATA.get(stage, [])
+        for idx, tensor in enumerate(chunks):
+            key = f"{stage}__chunk_{idx:06d}" if len(chunks) > 1 else stage
+            payload[key] = tensor
+            row = {
+                "key": key,
+                "shape": list(tensor.shape),
+                "dtype": str(tensor.dtype),
+            }
+            if idx < len(stage_row_metadata):
+                row["row_metadata"] = stage_row_metadata[idx]
+            stage_rows.append(row)
+        metadata[stage] = stage_rows
+    return payload, metadata
+
+
+def flush_tensor_trace_tensors(
+    tensor_file: str | os.PathLike[str] | None = None,
+    *,
+    clear: bool = True,
+) -> None:
+    target = str(tensor_file) if tensor_file is not None else _tensor_file()
+    if not target:
+        return
+    payload, metadata = _payload_and_metadata()
+    if payload:
+        path = Path(target)
+        path.parent.mkdir(parents=True, exist_ok=True)
+        save_file(payload, str(path))
+        path.with_suffix(path.suffix + ".meta.json").write_text(
+            json.dumps(metadata, indent=2, sort_keys=True) + "\n",
+            encoding="utf-8",
+        )
+    if clear:
+        clear_tensor_trace_tensors()
