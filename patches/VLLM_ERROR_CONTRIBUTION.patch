diff --git a/vllm/model_executor/models/error_contribution_trace.py b/vllm/model_executor/models/error_contribution_trace.py
new file mode 100644
index 000000000..925cff2cf
--- /dev/null
+++ b/vllm/model_executor/models/error_contribution_trace.py
@@ -0,0 +1,530 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Env-gated tensor hooks for local error-contribution experiments."""
+
+from __future__ import annotations
+
+import json
+import os
+import re
+from contextlib import contextmanager
+from collections.abc import Iterable
+from pathlib import Path
+
+import torch
+import torch.nn.functional as F
+from safetensors.torch import safe_open, save_file
+
+_REFERENCE_MODE = "reference"
+_CANDIDATE_MODE = "candidate"
+_MODES = {_REFERENCE_MODE, _CANDIDATE_MODE}
+
+_TENSORS: dict[str, list[torch.Tensor]] = {}
+_MSE_TENSORS: dict[str, list[torch.Tensor]] = {}
+_PAIR_TENSORS: dict[str, list[torch.Tensor]] = {}
+_CANDIDATE_TENSORS: dict[str, list[torch.Tensor]] = {}
+_INPUT_DIFFS: dict[tuple[int, int], torch.Tensor] = {}
+_POST_DIFFS: dict[tuple[int, int], torch.Tensor] = {}
+_FINAL_NORM_INPUT_DIFFS: dict[int, torch.Tensor] = {}
+_TOKEN_FILTER_OVERRIDE: tuple[bool, tuple[int, ...], int | None] | None = None
+_WARNED: set[str] = set()
+_INPUT_STAGE_RE = re.compile(r"^layer_(\d+)\.input_layernorm\.output\.residual$")
+_POST_STAGE_RE = re.compile(r"^layer_(\d+)\.post_attention_layernorm\.output\.residual$")
+_FULL_ROW_STAGE_RE = re.compile(r"^attention\.(?:k_full|v_full)\.\d+$")
+_RAW_CANDIDATE_STAGE_RE = re.compile(
+    r"^(?:attention\.(?:q|k_full|v_full|core_output)\.\d+|"
+    r"block\.mlp\.(?:input|output)\.\d+|"
+    r"oracle\.block\.mlp\.output\.\d+)$"
+)
+_ORACLE_STAGE_RE = re.compile(r"^oracle\.")
+
+
+def _output_file() -> str:
+    return os.environ.get("VLLM_ERROR_CONTRIBUTION_OUTPUT_FILE", "")
+
+
+def _reference_file() -> str:
+    return os.environ.get("VLLM_ERROR_CONTRIBUTION_REFERENCE_FILE", "")
+
+
+def _mode() -> str:
+    value = os.environ.get("VLLM_ERROR_CONTRIBUTION_MODE", "").strip().lower()
+    if not value:
+        return ""
+    if value not in _MODES:
+        raise ValueError(
+            "VLLM_ERROR_CONTRIBUTION_MODE must be one of "
+            f"{sorted(_MODES)}; got {value!r}"
+        )
+    return value
+
+
+def error_contribution_enabled() -> bool:
+    return bool(_output_file() and _mode())
+
+
+def _stage_enabled(stage: str) -> bool:
+    pattern = os.environ.get("VLLM_ERROR_CONTRIBUTION_STAGE_REGEX", "")
+    if not pattern:
+        return True
+    return re.search(pattern, stage) is not None
+
+
+def _parse_token_indices(
+    value: str | Iterable[int],
+    *,
+    source: str,
+) -> tuple[int, ...]:
+    raw_items = re.split(r"[,;+\s]+", value.strip()) if isinstance(value, str) else value
+    token_indices: list[int] = []
+    seen: set[int] = set()
+    for item in raw_items:
+        if item == "":
+            continue
+        try:
+            index = int(item)
+        except (TypeError, ValueError) as exc:
+            raise ValueError(f"{source} must contain integer row indices") from exc
+        if index < 0:
+            raise ValueError(f"{source} does not support negative indices")
+        if index in seen:
+            continue
+        seen.add(index)
+        token_indices.append(index)
+    return tuple(token_indices)
+
+
+def _expected_rows_from_env() -> int | None:
+    value = os.environ.get("VLLM_ERROR_CONTRIBUTION_EXPECTED_ROWS", "").strip()
+    if not value:
+        return None
+    expected = int(value)
+    if expected <= 0:
+        raise ValueError("VLLM_ERROR_CONTRIBUTION_EXPECTED_ROWS must be positive")
+    return expected
+
+
+def set_error_contribution_token_filter(
+    token_indices: str | Iterable[int] | None,
+    *,
+    expected_rows: int | None = None,
+) -> None:
+    """Set selected row indices for the next traced prefill batch."""
+
+    global _TOKEN_FILTER_OVERRIDE
+    if token_indices is None:
+        _TOKEN_FILTER_OVERRIDE = (False, (), expected_rows)
+        return
+    _TOKEN_FILTER_OVERRIDE = (
+        True,
+        _parse_token_indices(token_indices, source="set_error_contribution_token_filter"),
+        expected_rows,
+    )
+
+
+def clear_error_contribution_token_filter_override() -> None:
+    global _TOKEN_FILTER_OVERRIDE
+    _TOKEN_FILTER_OVERRIDE = None
+
+
+def _token_filter() -> tuple[bool, tuple[int, ...], int | None]:
+    if _TOKEN_FILTER_OVERRIDE is not None:
+        return _TOKEN_FILTER_OVERRIDE
+    if "VLLM_ERROR_CONTRIBUTION_TOKEN_INDICES" in os.environ:
+        return (
+            True,
+            _parse_token_indices(
+                os.environ["VLLM_ERROR_CONTRIBUTION_TOKEN_INDICES"],
+                source="VLLM_ERROR_CONTRIBUTION_TOKEN_INDICES",
+            ),
+            _expected_rows_from_env(),
+        )
+    return False, (), _expected_rows_from_env()
+
+
+def clear_error_contribution_trace() -> None:
+    _TENSORS.clear()
+    _MSE_TENSORS.clear()
+    _PAIR_TENSORS.clear()
+    _CANDIDATE_TENSORS.clear()
+    _INPUT_DIFFS.clear()
+    _POST_DIFFS.clear()
+    _FINAL_NORM_INPUT_DIFFS.clear()
+    _WARNED.clear()
+
+
+def _warn_once(stage: str, reason: str) -> None:
+    key = f"{stage}:{reason}"
+    if key in _WARNED:
+        return
+    _WARNED.add(key)
+    import warnings
+
+    warnings.warn(
+        f"Skipping error-contribution trace for {stage}: {reason}",
+        RuntimeWarning,
+        stacklevel=3,
+    )
+
+
+def _select_rows(stage: str, tensor: torch.Tensor) -> torch.Tensor | None:
+    enabled, token_indices, expected_rows = _token_filter()
+    if expected_rows is not None and (
+        tensor.ndim == 0 or int(tensor.shape[0]) != int(expected_rows)
+    ):
+        return None
+    if _FULL_ROW_STAGE_RE.fullmatch(stage):
+        return tensor
+    if not enabled:
+        return tensor
+    if not token_indices:
+        return None
+    if tensor.ndim == 0:
+        _warn_once(stage, "scalar tensor has no token row dimension")
+        return None
+    valid_indices = [idx for idx in token_indices if idx < tensor.shape[0]]
+    if not valid_indices:
+        return None
+    indices = torch.tensor(valid_indices, dtype=torch.long, device=tensor.device)
+    return tensor.index_select(0, indices)
+
+
+def _to_cpu_float(tensor: torch.Tensor) -> torch.Tensor:
+    if torch.is_floating_point(tensor):
+        tensor = tensor.to(torch.float32)
+    return tensor.detach().cpu().contiguous().clone()
+
+
+def _next_key(stage: str, count: int) -> str:
+    if count == 0:
+        return stage
+    return f"{stage}__chunk_{count:06d}"
+
+
+def _reference_tensor(stage: str, count: int) -> torch.Tensor:
+    path = _reference_file()
+    if not path:
+        raise RuntimeError("candidate mode requires VLLM_ERROR_CONTRIBUTION_REFERENCE_FILE")
+    key = _next_key(stage, count)
+    fallback_key = f"{stage}__chunk_{count:06d}"
+    with safe_open(path, framework="pt", device="cpu") as handle:
+        keys = set(handle.keys())
+        selected_key = key if key in keys else fallback_key
+        if selected_key not in keys:
+            raise KeyError(
+                f"reference tensor {key!r}/{fallback_key!r} not found in {path}"
+            )
+        return handle.get_tensor(selected_key).to(torch.float32)
+
+
+def _record_reference(stage: str, selected: torch.Tensor) -> None:
+    _TENSORS.setdefault(stage, []).append(_to_cpu_float(selected))
+
+
+def _record_candidate_raw(stage: str, selected: torch.Tensor) -> None:
+    _CANDIDATE_TENSORS.setdefault(stage, []).append(_to_cpu_float(selected))
+
+
+@contextmanager
+def _strict_fp32_matmul():
+    old_precision = torch.get_float32_matmul_precision()
+    old_cuda_tf32 = torch.backends.cuda.matmul.allow_tf32
+    old_cudnn_tf32 = torch.backends.cudnn.allow_tf32
+    try:
+        torch.set_float32_matmul_precision("highest")
+        torch.backends.cuda.matmul.allow_tf32 = False
+        torch.backends.cudnn.allow_tf32 = False
+        yield
+    finally:
+        torch.set_float32_matmul_precision(old_precision)
+        torch.backends.cuda.matmul.allow_tf32 = old_cuda_tf32
+        torch.backends.cudnn.allow_tf32 = old_cudnn_tf32
+
+
+def _linear_fp32(layer: object, x: torch.Tensor) -> torch.Tensor:
+    weight = getattr(layer, "weight", None)
+    if weight is None:
+        raise AttributeError(f"{type(layer).__name__} has no weight tensor")
+    bias = getattr(layer, "bias", None)
+    weight_tensor = weight.detach().to(device=x.device, dtype=torch.float32)
+    bias_tensor = None
+    if bias is not None:
+        bias_tensor = bias.detach().to(device=x.device, dtype=torch.float32)
+    return F.linear(x.to(torch.float32), weight_tensor, bias_tensor)
+
+
+def _rmsnorm_fp32(layer: object, x: torch.Tensor) -> torch.Tensor:
+    x_fp32 = x.to(torch.float32)
+    weight = getattr(layer, "weight", None)
+    variance_size_override = getattr(layer, "variance_size_override", None)
+    x_var = x_fp32 if variance_size_override is None else x_fp32[..., :variance_size_override]
+    variance = x_var.pow(2).mean(dim=-1, keepdim=True)
+    eps = float(getattr(layer, "variance_epsilon", getattr(layer, "eps", 1e-6)))
+    output = x_fp32 * torch.rsqrt(variance + eps)
+    if weight is None:
+        return output
+    return output * weight.detach().to(device=x.device, dtype=torch.float32)
+
+
+def record_mlp_block_oracle(name: str, post_attention_layernorm: object,
+                            mlp_module: object,
+                            residual_stream: torch.Tensor) -> None:
+    if not error_contribution_enabled() or _mode() != _CANDIDATE_MODE:
+        return
+    if not _stage_enabled(name):
+        return
+    with torch.no_grad(), _strict_fp32_matmul():
+        x = residual_stream.to(torch.float32)
+        normed = _rmsnorm_fp32(post_attention_layernorm, x)
+        gate_up = _linear_fp32(mlp_module.gate_up_proj, normed)
+        gate, up = gate_up.chunk(2, dim=-1)
+        hidden = F.silu(gate) * up
+        mlp_out = _linear_fp32(mlp_module.down_proj, hidden)
+        record_error_contribution_tensor(name, x + mlp_out)
+
+
+def _row_mean(tensor: torch.Tensor) -> torch.Tensor:
+    if tensor.ndim == 0:
+        return tensor.reshape(1)
+    return tensor.reshape(tensor.shape[0], -1).mean(dim=1)
+
+
+def _pair_statistics(before: torch.Tensor, after: torch.Tensor) -> dict[str, torch.Tensor]:
+    if tuple(before.shape) != tuple(after.shape):
+        raise RuntimeError(
+            f"shape mismatch for paired residual tensors: before {tuple(before.shape)} "
+            f"vs after {tuple(after.shape)}"
+        )
+    delta = after - before
+    before_mse = _row_mean(before.square())
+    mean_product = _row_mean(after * before)
+    cross = mean_product - before_mse
+    stats = {
+        "delta_mse": _row_mean(delta.square()),
+        "before_mse": before_mse,
+        "mean_product": mean_product,
+        "cross": cross,
+        "covariance": cross,
+    }
+    if before.ndim == 0:
+        stats["before_delta_rho"] = torch.zeros(1, dtype=torch.float32)
+    else:
+        before_flat = before.reshape(before.shape[0], -1)
+        delta_flat = delta.reshape(delta.shape[0], -1)
+        denom = before_flat.norm(dim=1) * delta_flat.norm(dim=1)
+        rho = torch.zeros_like(denom)
+        valid = denom > 0
+        rho[valid] = (before_flat[valid] * delta_flat[valid]).sum(dim=1) / denom[valid]
+        stats["before_delta_rho"] = rho
+    if before.ndim == 0:
+        stats["centered_covariance"] = torch.zeros(1, dtype=torch.float32)
+    else:
+        before_flat = before.reshape(before.shape[0], -1)
+        after_flat = after.reshape(after.shape[0], -1)
+        before_centered = before_flat - before_flat.mean(dim=1, keepdim=True)
+        after_centered = after_flat - after_flat.mean(dim=1, keepdim=True)
+        stats["centered_covariance"] = (before_centered * after_centered).mean(dim=1)
+    return {key: value.to(torch.float32).contiguous() for key, value in stats.items()}
+
+
+def _append_pair_stat(kind: str, layer: int | None, metric: str, values: torch.Tensor) -> None:
+    key = f"{kind}.{metric}" if layer is None else f"{kind}.{metric}.{layer}"
+    _PAIR_TENSORS.setdefault(key, []).append(values)
+
+
+def _record_residual_pair(
+    *,
+    kind: str,
+    layer: int | None,
+    before: torch.Tensor,
+    after: torch.Tensor,
+) -> None:
+    for metric, values in _pair_statistics(before, after).items():
+        _append_pair_stat(kind, layer, metric, values)
+
+
+def _record_candidate_pairs(stage: str, chunk_index: int, diff: torch.Tensor) -> None:
+    input_match = _INPUT_STAGE_RE.fullmatch(stage)
+    if input_match is not None:
+        layer = int(input_match.group(1))
+        _INPUT_DIFFS[(layer, chunk_index)] = diff
+        previous_post = _POST_DIFFS.pop((layer - 1, chunk_index), None)
+        if previous_post is not None:
+            _record_residual_pair(
+                kind="mlp",
+                layer=layer - 1,
+                before=previous_post,
+                after=diff,
+            )
+        return
+
+    post_match = _POST_STAGE_RE.fullmatch(stage)
+    if post_match is not None:
+        layer = int(post_match.group(1))
+        input_diff = _INPUT_DIFFS.pop((layer, chunk_index), None)
+        if input_diff is not None:
+            _record_residual_pair(
+                kind="attention",
+                layer=layer,
+                before=input_diff,
+                after=diff,
+            )
+        _POST_DIFFS[(layer, chunk_index)] = diff
+        return
+
+    if stage == "forward.norm.input":
+        _FINAL_NORM_INPUT_DIFFS[chunk_index] = diff
+        pending_posts = [
+            (layer, post_diff)
+            for (layer, stored_chunk), post_diff in _POST_DIFFS.items()
+            if stored_chunk == chunk_index
+        ]
+        if pending_posts:
+            layer, post_diff = max(pending_posts, key=lambda item: item[0])
+            _POST_DIFFS.pop((layer, chunk_index), None)
+            _record_residual_pair(
+                kind="mlp",
+                layer=layer,
+                before=post_diff,
+                after=diff,
+            )
+        return
+
+    if stage == "forward.norm.hidden":
+        norm_input = _FINAL_NORM_INPUT_DIFFS.pop(chunk_index, None)
+        if norm_input is not None:
+            _record_residual_pair(
+                kind="final_norm",
+                layer=None,
+                before=norm_input,
+                after=diff,
+            )
+
+
+def _record_candidate(stage: str, selected: torch.Tensor) -> None:
+    if _RAW_CANDIDATE_STAGE_RE.fullmatch(stage):
+        _record_candidate_raw(stage, selected)
+    if _ORACLE_STAGE_RE.match(stage):
+        return
+
+    chunks = _MSE_TENSORS.setdefault(stage, [])
+    chunk_index = len(chunks)
+    reference = _reference_tensor(stage, chunk_index)
+    candidate = selected.detach().to(torch.float32).cpu()
+    if tuple(candidate.shape) != tuple(reference.shape):
+        raise RuntimeError(
+            f"shape mismatch for {stage}: candidate {tuple(candidate.shape)} "
+            f"vs reference {tuple(reference.shape)}"
+        )
+    diff = candidate - reference
+    if diff.ndim == 0:
+        mse = diff.square().reshape(1)
+    else:
+        mse = diff.square().reshape(diff.shape[0], -1).mean(dim=1)
+    chunks.append(mse.to(torch.float32).contiguous())
+    _record_candidate_pairs(stage, chunk_index, diff)
+
+
+def record_error_contribution_tensor(stage: str, tensor: torch.Tensor) -> torch.Tensor:
+    if not error_contribution_enabled() or not _stage_enabled(stage):
+        return tensor
+    if not torch.is_tensor(tensor):
+        return tensor
+    with torch.no_grad():
+        selected = _select_rows(stage, tensor)
+        if selected is None:
+            return tensor
+        mode = _mode()
+        if mode == _REFERENCE_MODE:
+            _record_reference(stage, selected)
+        elif mode == _CANDIDATE_MODE:
+            _record_candidate(stage, selected)
+    return tensor
+
+
+def _raw_payload_and_metadata() -> tuple[dict[str, torch.Tensor], dict[str, object]]:
+    payload: dict[str, torch.Tensor] = {}
+    metadata: dict[str, object] = {}
+    for stage, chunks in _TENSORS.items():
+        rows = []
+        multiple = len(chunks) > 1
+        for idx, tensor in enumerate(chunks):
+            key = f"{stage}__chunk_{idx:06d}" if multiple else stage
+            payload[key] = tensor
+            rows.append({"key": key, "shape": list(tensor.shape), "dtype": str(tensor.dtype)})
+        metadata[stage] = rows
+    return payload, metadata
+
+
+def _mse_payload() -> dict[str, object]:
+    stages: dict[str, torch.Tensor] = {}
+    metadata: dict[str, object] = {}
+    for stage, chunks in _MSE_TENSORS.items():
+        if not chunks:
+            continue
+        tensor = torch.cat(chunks, dim=0).to(torch.float32).contiguous()
+        stages[stage] = tensor
+        metadata[stage] = {
+            "shape": list(tensor.shape),
+            "dtype": str(tensor.dtype),
+            "chunks": len(chunks),
+        }
+    pairs: dict[str, torch.Tensor] = {}
+    pair_metadata: dict[str, object] = {}
+    for name, chunks in _PAIR_TENSORS.items():
+        if not chunks:
+            continue
+        tensor = torch.cat(chunks, dim=0).to(torch.float32).contiguous()
+        pairs[name] = tensor
+        pair_metadata[name] = {
+            "shape": list(tensor.shape),
+            "dtype": str(tensor.dtype),
+            "chunks": len(chunks),
+        }
+    candidate_tensors: dict[str, torch.Tensor] = {}
+    candidate_metadata: dict[str, object] = {}
+    for stage, chunks in _CANDIDATE_TENSORS.items():
+        if not chunks:
+            continue
+        tensor = torch.cat(chunks, dim=0).to(torch.float32).contiguous()
+        candidate_tensors[stage] = tensor
+        candidate_metadata[stage] = {
+            "shape": list(tensor.shape),
+            "dtype": str(tensor.dtype),
+            "chunks": len(chunks),
+        }
+    return {
+        "schema_version": 3,
+        "mode": _CANDIDATE_MODE,
+        "reference_file": _reference_file(),
+        "stages": stages,
+        "metadata": metadata,
+        "pairs": pairs,
+        "pair_metadata": pair_metadata,
+        "candidate_tensors": candidate_tensors,
+        "candidate_metadata": candidate_metadata,
+    }
+
+
+def flush_error_contribution_trace(
+    output_file: str | os.PathLike[str] | None = None,
+    *,
+    clear: bool = True,
+) -> None:
+    target = str(output_file) if output_file is not None else _output_file()
+    if not target:
+        return
+    path = Path(target)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    mode = _mode()
+    if mode == _REFERENCE_MODE:
+        payload, metadata = _raw_payload_and_metadata()
+        if payload:
+            save_file(payload, str(path))
+            path.with_suffix(path.suffix + ".meta.json").write_text(
+                json.dumps(metadata, indent=2, sort_keys=True) + "\n",
+                encoding="utf-8",
+            )
+    elif mode == _CANDIDATE_MODE and (_MSE_TENSORS or _PAIR_TENSORS or _CANDIDATE_TENSORS):
+        torch.save(_mse_payload(), path)
+    if clear:
+        clear_error_contribution_trace()
